// PNE 1.6.5 — Corte institucional mensual, del 12 al 11 del mes siguiente.
function pneCorteDatos(mes){
    if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(String(mes||'')))return null;
    const [anio,numeroMes]=mes.split('-').map(Number);
    const comienzo=new Date(Date.UTC(anio,numeroMes-1,12));
    const fin=new Date(Date.UTC(anio,numeroMes,11));
    const dias=[],cursor=new Date(comienzo);
    const iso=d=>d.toISOString().slice(0,10);
    while(cursor<=fin){dias.push(iso(cursor));cursor.setUTCDate(cursor.getUTCDate()+1);}
    return {desde:iso(comienzo),hasta:iso(fin),dias,etiqueta:desdeHastaCorte(iso(comienzo),iso(fin))};
}
function desdeHastaCorte(desde,hasta){
    return desde.slice(8)+'/'+desde.slice(5,7)+'/'+desde.slice(0,4)+' AL '+hasta.slice(8)+'/'+hasta.slice(5,7)+'/'+hasta.slice(0,4);
}
function actualizarEtiquetaCorte(){
    const entrada=document.getElementById('mes-inicio-corte');
    const salida=document.getElementById('corte-fechas-visible');
    if(!entrada||!salida)return;
