                    actualizadoEn:firebase.firestore.FieldValue.serverTimestamp()
                };
                await ref.update(payload);
                // Leer hora asentada por el servidor antes de mostrar estado y
                // permitir nuevas acciones; no usar la hora del navegador.
                const actualizado=await ref.get({source:'server'});
                configuracionHorarios={...HORARIO_PREDETERMINADO,...actualizado.data()};
