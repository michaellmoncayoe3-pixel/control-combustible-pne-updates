// Pantallas independientes: solo una sección visible a la vez.
let pasoActual = 1;
let seccionActual = 'inicio';
function avisoPaso(mensaje, campo){
  alert('⚠️ ' + mensaje);
  if(campo) document.getElementById(campo)?.focus();
  return false;
}
function validarPaso1(){
  const sector=document.getElementById('sector-abastecimiento').value.trim();
  if(!sector) return avisoPaso('Escriba el sector o unidad policial.', 'sector-abastecimiento');
  if(pneModoAdminOCR){try{pneIdentidadAdminOCR();}catch(e){return avisoPaso(e.message,'pne-admin-ocr-nombre');}}
  if(!vehiculoSeleccionado) return avisoPaso('Seleccione el vehículo antes de continuar.', 'buscar-vehiculo');
  return true;
}
function validarPaso2(){
  if(!validarPaso1()) return false;
  const kmCampo=document.getElementById('nuevo-km');
  const km=Number(kmCampo.value), previo=Number(vehiculoSeleccionado.ultimoKm||0);
  if(!kmCampo.value || !Number.isFinite(km) || km<=previo)
    return avisoPaso('El kilometraje debe ser mayor a '+previo+'.', 'nuevo-km');
  if(!fotoOdometro) return avisoPaso('Adjunte la fotografía del odómetro.', 'foto-odometro');
  if(!Number(vehiculoSeleccionado.rendimientoKmPorGalon||0))
    return avisoPaso('El vehículo no tiene rendimiento configurado. Contacte al administrador.');
  return true;
}
function irPaso(paso){
  if(!Number.isInteger(paso) || paso<1 || paso>3) return false;
  if(paso>=2 && !validarPaso1()) return false;
  if(paso===3){
    if(!validarPaso2()) return false;
    // Si se editó el kilometraje después del cálculo, se recalcula antes de avanzar.
    calcularConsumo();
    if(document.getElementById('seccion-factura').classList.contains('oculto')) return false;
  }
  pasoActual=paso;
  for(let i=1;i<=3;i++) document.getElementById('app-step-'+i).classList.toggle('oculto',i!==paso);
  document.querySelectorAll('#app-step-track span').forEach((e,i)=>e.classList.toggle('done',i<paso));
  const contadorPaso=document.getElementById('pne-step-count'); if(contadorPaso) contadorPaso.textContent=paso+'/3';
  document.getElementById('app-step-label').textContent=[
    'Paso 1 de 3 · Sector y vehículo',
    'Paso 2 de 3 · Kilometraje y odómetro',
    'Paso 3 de 3 · Factura y confirmación'
  ][paso-1];
  if(seccionActual==='abastecer') window.scrollTo({top:0,behavior:'instant'});
  return true;
}
function abrirSeccion(seccion){
  if(!['inicio','abastecer','perfil','admin'].includes(seccion)) return;
  if(seccion==='admin' && !esAdmin) { alert('⛔ Acceso denegado. Solo los administradores autorizados pueden ingresar a esta sección.'); return; }
  seccionActual=seccion;
  if(seccion!=='abastecer'){
    clearTimeout(temporizadorBusquedaVehiculos);
    ++busquedaVehiculosSecuencia;
  }
  const visibilidad={
    'pne-inicio':seccion==='inicio',
    'app-shell':seccion==='abastecer',
    'app-wizard':seccion==='abastecer',
    'app-profile':seccion==='perfil',
    'panel-version':seccion==='perfil',
    'panel-admin':seccion==='admin' && esAdmin
  };
  for(const [id,visible] of Object.entries(visibilidad))
    document.getElementById(id)?.classList.toggle('oculto',!visible);
  if(seccion==='abastecer'){
    if(!pneModoAdminOCR)document.getElementById('pne-admin-ocr-identidad').classList.add('oculto');
    // Al abrir una operación se inicia en la primera página.
    pasoActual=1;
    for(let i=1;i<=3;i++) document.getElementById('app-step-'+i).classList.toggle('oculto',i!==1);
    document.querySelectorAll('#app-step-track span').forEach((e,i)=>e.classList.toggle('done',i===0));
    document.getElementById('app-step-label').textContent='Sector y vehículo';
    const contadorInicio=document.getElementById('pne-step-count'); if(contadorInicio) contadorInicio.textContent='1/3';
  }
  if(seccion==='admin'){
    pneVistaAdminIndependiente(null);
    adminTabActual=null;
    document.getElementById('admin-detalle')?.classList.add('oculto');
    document.getElementById('admin-vehiculos-acciones')?.classList.add('oculto');
    document.getElementById('admin-reporte')?.classList.add('oculto');
    document.getElementById('admin-registro-manual')?.classList.add('oculto');
    document.getElementById('admin-editor')?.classList.add('oculto');
    document.getElementById('admin-contenido')?.replaceChildren();
  }
  window.scrollTo({top:0,behavior:'instant'});
}
