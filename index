<script>
/* v1.6.0: editor de recorte exclusivo; mejoras automáticas en la preparación OCR. */
(function(){
'use strict';
const modal=document.getElementById('pne-editor'),canvas=document.getElementById('pne-canvas'),ctx=canvas.getContext('2d');
const sel=document.getElementById('pne-seleccion'),box=document.getElementById('pne-canvas-box');
let entrada=null,archivoCompleto=null,imagen=null,base=null,rectSel=null,arrastrando=null,ocupado=false,recorteAplicado=false;
const estado=document.getElementById('pne-editor-estado');
const controlar=(id,fn)=>document.getElementById(id).addEventListener('click',fn);
function render(){
 if(!base)return;
 canvas.width=base.width;canvas.height=base.height;
 ctx.clearRect(0,0,canvas.width,canvas.height);ctx.drawImage(base,0,0);
 pintarSel();
}
function pintarSel(){
 const d=canvas.getBoundingClientRect(),b=box.getBoundingClientRect();
 if(!rectSel||rectSel.w<4||rectSel.h<4){sel.style.display='none';return;}
 sel.style.display='block';sel.style.left=(d.left-b.left+rectSel.x/canvas.width*d.width)+'px';
 sel.style.top=(d.top-b.top+rectSel.y/canvas.height*d.height)+'px';
 sel.style.width=(rectSel.w/canvas.width*d.width)+'px';sel.style.height=(rectSel.h/canvas.height*d.height)+'px';
}
function punto(e){const r=canvas.getBoundingClientRect();return {x:Math.max(0,Math.min(canvas.width,((e.clientX-r.left)/r.width)*canvas.width)),y:Math.max(0,Math.min(canvas.height,((e.clientY-r.top)/r.height)*canvas.height))};}
canvas.addEventListener('pointerdown',e=>{if(!base)return;e.preventDefault();const p=punto(e);arrastrando=p;rectSel={x:p.x,y:p.y,w:0,h:0};canvas.setPointerCapture(e.pointerId);});
canvas.addEventListener('pointermove',e=>{if(!arrastrando)return;const p=punto(e);rectSel={x:Math.min(arrastrando.x,p.x),y:Math.min(arrastrando.y,p.y),w:Math.abs(p.x-arrastrando.x),h:Math.abs(p.y-arrastrando.y)};pintarSel();});
canvas.addEventListener('pointerup',()=>{arrastrando=null;if(rectSel&&(rectSel.w<8||rectSel.h<8))rectSel=null;pintarSel();});
canvas.addEventListener('pointercancel',()=>{arrastrando=null;});
function recorte(){if(!rectSel||!base)return false;const c=document.createElement('canvas');c.width=Math.round(rectSel.w);c.height=Math.round(rectSel.h);if(c.width<30||c.height<30)return false;c.getContext('2d').drawImage(base,rectSel.x,rectSel.y,rectSel.w,rectSel.h,0,0,c.width,c.height);base=c;rectSel=null;recorteAplicado=true;render();return true;}
controlar('pne-recortar',()=>{estado.textContent=recorte()?'Área recortada correctamente.':'Seleccione un área de recorte arrastrando sobre la foto.';});
controlar('pne-recorte-reset',()=>{if(imagen){base=document.createElement('canvas');base.width=imagen.width;base.height=imagen.height;base.getContext('2d').drawImage(imagen,0,0);rectSel=null;recorteAplicado=false;render();estado.textContent='Imagen completa restaurada.';}});
function cerrar(){if(entrada)entrada.value='';modal.classList.remove('pne-visible');document.body.classList.remove('pne-editando');rectSel=null;arrastrando=null;entrada=null;archivoCompleto=null;imagen=null;base=null;ocupado=false;recorteAplicado=false;}
controlar('pne-editor-cerrar',cerrar);
controlar('pne-repetir',()=>{const input=entrada;cerrar();if(input){input.value='';input.click();}});

// Detección aproximada de papel claro sobre fondo contrastante. Usa una muestra
// de baja resolución; no recorta si la evidencia visual no es suficientemente clara.
function sugerirRecorteFactura(origen){
 const m=150, factor=Math.min(1,m/Math.max(origen.width,origen.height));
 const cv=document.createElement('canvas');cv.width=Math.round(origen.width*factor);cv.height=Math.round(origen.height*factor);
 const cc=cv.getContext('2d',{willReadFrequently:true});cc.drawImage(origen,0,0,cv.width,cv.height);
 const w=cv.width,h=cv.height,p=cc.getImageData(0,0,w,h).data;
 const lum=(x,y)=>{const i=(y*w+x)*4;return (.2126*p[i]+.7152*p[i+1]+.0722*p[i+2]);};
 const threshold=174;
 // Las filas/columnas con mayoría de píxeles claros describen el papel,
 // incluso si contiene texto oscuro. Ignorar franjas finas de luz ambiental.
 const filas=[],cols=[];
 for(let y=0;y<h;y++){let n=0;for(let x=0;x<w;x++)if(lum(x,y)>threshold)n++;if(n/w>.58)filas.push(y);}
 for(let x=0;x<w;x++){let n=0;for(let y=0;y<h;y++)if(lum(x,y)>threshold)n++;if(n/h>.52)cols.push(x);}
 if(filas.length<h*.24||cols.length<w*.24)return null;
 let x0=cols[0],x1=cols[cols.length-1],y0=filas[0],y1=filas[filas.length-1];
 // No confiar en imágenes donde casi toda la foto es brillante (sin contraste).
 if((x1-x0)>w*.98&&(y1-y0)>h*.98)return null;
 // Ampliar unos píxeles para no cortar letras ni los bordes del comprobante.
 const padX=Math.round(w*.025),padY=Math.round(h*.025);
 x0=Math.max(0,x0-padX);x1=Math.min(w,x1+padX);y0=Math.max(0,y0-padY);y1=Math.min(h,y1+padY);
 if((x1-x0)<w*.38||(y1-y0)<h*.33)return null;
 return {x:Math.round(x0/factor),y:Math.round(y0/factor),w:Math.min(origen.width-Math.round(x0/factor),Math.round((x1-x0)/factor)),h:Math.min(origen.height-Math.round(y0/factor),Math.round((y1-y0)/factor))};
}
async function abrir(input,file){
 if(!['foto-factura','foto-odometro'].includes(input.id))return;
 entrada=input;archivoCompleto=file;ocupado=true;estado.textContent='Preparando fotografía...';modal.classList.add('pne-visible');document.body.classList.add('pne-editando');
 document.getElementById('pne-editor-titulo').textContent=input.id==='foto-odometro'?'Recortar foto del odómetro':'Factura · recorte automático';
 rectSel=null;recorteAplicado=false;
 try{
  let bitmap;
  try{bitmap=await createImageBitmap(file);}catch(err){throw new Error('No fue posible abrir la fotografía. Utilice JPG o PNG.');}
  // Limitar memoria en móviles, conservando resolución útil para OCR.
  const scale=Math.min(1,2200/Math.max(bitmap.width,bitmap.height));
  imagen=document.createElement('canvas');imagen.width=Math.max(1,Math.round(bitmap.width*scale));imagen.height=Math.max(1,Math.round(bitmap.height*scale));
  imagen.getContext('2d').drawImage(bitmap,0,0,imagen.width,imagen.height);bitmap.close?.();
  base=document.createElement('canvas');base.width=imagen.width;base.height=imagen.height;base.getContext('2d').drawImage(imagen,0,0);
  render();
  if(input.id==='foto-factura'){
    const sugerido=sugerirRecorteFactura(imagen);
    if(sugerido){rectSel=sugerido;pintarSel();estado.textContent='✓ Recorte automático sugerido. Revise que estén la placa, fecha y cantidad de galones. Pulse «Usar imagen y verificar» o ajuste el recorte.';}
    else estado.textContent='No se detectaron bordes seguros. Seleccione manualmente la factura o use la foto completa. La imagen original se conservará.';
  }else estado.textContent='Seleccione únicamente los dígitos del kilometraje TOTAL. La evidencia guardada será la fotografía completa.';
 }catch(err){estado.textContent=err.message||'No se pudo abrir la imagen.';base=null;}
}
// Intercepta la selección antes de que se invoque cargarFoto(input, vista) en HTML.
for(const id of ['foto-factura','foto-odometro']){
 const input=document.getElementById(id);if(!input)continue;
 input.addEventListener('change',e=>{
  if(input.dataset.pneEditado==='1')return;
  const file=input.files?.[0];if(!file)return;
  e.stopImmediatePropagation();
  if(!/^image\//.test(file.type)){estado.textContent='Seleccione una imagen válida.';input.value='';return;}
  abrir(input,file);
 },true);
}
controlar('pne-usar',async()=>{
 if(!base||!entrada||!ocupado){estado.textContent='Seleccione primero una fotografía.';return;}
 const usar=document.getElementById('pne-usar');usar.disabled=true;
 try{
  if(entrada.id==='foto-odometro' && !rectSel && !recorteAplicado)throw new Error('Seleccione los dígitos del kilometraje; se conservará la foto completa.');
  if(rectSel){if(!recorte())throw new Error('El recorte seleccionado es demasiado pequeño.');}
  const final=document.createElement('canvas');final.width=base.width;final.height=base.height;
  const fc=final.getContext('2d');fc.drawImage(base,0,0);
  const blob=await new Promise(resolve=>final.toBlob(resolve,'image/jpeg',.88));
  if(!blob)throw new Error('No se pudo preparar la imagen.');
  const f=new File([blob],`evidencia-editada-${Date.now()}.jpg`,{type:'image/jpeg'});
  const input=entrada,id=input.id==='foto-odometro'?'preview-odometro':'preview-factura';
  const originalEvidencia=archivoCompleto;
  cerrar();
  document.getElementById(input.id==='foto-odometro'?'ocr-estado':'ocr-factura-estado').textContent='⏳ Imagen recibida. Verificando con Google Cloud Vision…';
  // Reutilizar el flujo OCR existente; guardar/validar se realiza desde la función original.
  cargarFoto({files:[f]},id,originalEvidencia);
 }catch(error){estado.textContent=pneMensajeErrorUsuario(error)||'No se pudo procesar la fotografía.';}
 finally{usar.disabled=false;}
});
})();
</script>

<!-- Instrucciones obligatorias antes de iniciar cada abastecimiento. -->
<div id="pne-guia-capa" role="presentation" aria-hidden="true">
  <section id="pne-guia-tarjeta" role="dialog" aria-modal="true" aria-labelledby="pne-guia-titulo" aria-describedby="pne-guia-introduccion" tabindex="-1">
    <header class="pne-guia-header">
      <div class="pne-guia-marca"><div class="pne-guia-emblema" aria-hidden="true">✦</div><div><div class="pne-guia-kicker">Policía Nacional del Ecuador</div><span class="pne-guia-marca-sub">Sistema de control de combustible · Indicaciones de uso</span></div></div>
      <h2 id="pne-guia-titulo" class="pne-guia-title">Antes de iniciar el abastecimiento</h2>
      <p id="pne-guia-introduccion" class="pne-guia-intro">Lea estas indicaciones para registrar el suministro correctamente. La información y las fotografías deben corresponder al abastecimiento real del vehículo seleccionado.</p>
    </header>
    <div class="pne-guia-contenido">
      <div class="pne-guia-seccion"><h3><span class="pne-guia-num">01</span> Procedimiento obligatorio</h3>
        <ol>
          <li><strong>Identifique el vehículo.</strong> Seleccione el sector y verifique que la placa corresponda al automotor que está abasteciendo.</li>
          <li><strong>Fotografíe y recorte el kilometraje.</strong> Tome una fotografía clara del odómetro TOTAL. En la pantalla de recorte, <strong>seleccione únicamente los números del kilometraje total</strong> y pulse la opción para aplicar el recorte antes de verificar con OCR. No incluya la velocidad ni el contador parcial (TRIP). <strong>La fotografía completa se conservará como evidencia.</strong></li>
          <li><strong>Declare los galones reales.</strong> Escriba la cantidad suministrada exactamente como consta en el comprobante.</li>
          <li><strong>Fotografíe la factura.</strong> Incluya la placa, la fecha y la cantidad de galones. Los tres datos deben coincidir con el registro.</li>
          <li><strong>Revise antes de confirmar.</strong> Verifique los datos mostrados por el sistema y finalice solo si son correctos.</li>
        </ol>
      <label class="pne-guia-aceptacion-item"><input type="checkbox" class="pne-guia-verificacion" data-tipo="procedimiento" onchange="pneActualizarAceptacionAbastecimiento()"><span>Confirmo que seguiré todos los pasos obligatorios, incluido el recorte del odómetro TOTAL.</span></label></div>
      <div class="pne-guia-seccion pne-guia-recomendacion"><h3><span class="pne-guia-num">02</span> Recomendaciones para evitar rechazos</h3>
        <ul>
          <li>Tome fotografías <strong>nítidas, completas y bien iluminadas</strong>, sin reflejos ni datos cortados.</li>
          <li>Compruebe el tipo de combustible del vehículo: <strong>ECO o DIÉSEL</strong>.</li>
          <li>Al recortar la imagen, <strong>acerque y centre los dígitos del odómetro TOTAL</strong>; evite reflejos, números cortados, velocímetro y recorrido parcial (TRIP).</li>
          <li>Si el OCR no reconoce un dato o hay una diferencia, <strong>detenga el proceso y comuníquelo al administrador</strong>.</li>
        </ul>
      <label class="pne-guia-aceptacion-item"><input type="checkbox" class="pne-guia-verificacion" data-tipo="recomendaciones" onchange="pneActualizarAceptacionAbastecimiento()"><span>Confirmo que he leído las recomendaciones para evitar errores y rechazos.</span></label></div>
      <div class="pne-guia-seccion pne-guia-prohibido"><h3><span class="pne-guia-num">03</span> Acciones no permitidas</h3>
        <ul>
          <li>Usar facturas de <strong>otro vehículo, otra fecha o un abastecimiento diferente</strong>.</li>
          <li><strong>Alterar, reutilizar o falsificar</strong> fotografías, facturas o datos del abastecimiento.</li>
          <li>Declarar <strong>galones o kilometrajes distintos de los reales</strong>.</li>
          <li><strong>Duplicar un abastecimiento</strong> o continuar con discrepancias sin solicitar revisión.</li>
        </ul>
      <p class="pne-guia-aviso-auditoria"><strong>Registro y responsabilidades.</strong> El sistema registra las operaciones y conserva evidencias y trazas de auditoría. Ante presuntos incumplimientos, inconsistencias o alteraciones, se informará a la autoridad competente para que, previa verificación y con respeto al debido proceso, se realicen los trámites administrativos o legales que correspondan conforme a la normativa vigente.</p>
      <label class="pne-guia-aceptacion-item"><input type="checkbox" class="pne-guia-verificacion" data-tipo="prohibiciones" onchange="pneActualizarAceptacionAbastecimiento()"><span>Confirmo que conozco las acciones no permitidas y me comprometo a respetarlas.</span></label></div>
    </div>
    <div class="pne-guia-pie">
      <label id="pne-guia-check-label"><input type="checkbox" id="pne-guia-acepto" onchange="pneActualizarAceptacionAbastecimiento()"><span>Declaro que he leído y comprendido las instrucciones, conozco que mi aceptación y las operaciones del sistema quedan registradas y me comprometo a proporcionar información verídica. Entiendo que los presuntos incumplimientos podrán ser puestos en conocimiento de la autoridad competente.</span></label>
      <p class="pne-guia-constancia-nota">La aceptación se guardará como constancia individual en Firebase, con su usuario, versión de estas instrucciones y fecha del servidor. Se solicitará nuevamente cuando cambie esta versión.</p>
      <p id="pne-guia-estado" class="pne-guia-estado" role="status" aria-live="polite"></p>
      <p id="pne-guia-progreso" class="pne-guia-progreso" role="status" aria-live="polite">0 de 4 confirmaciones aceptadas</p><div class="pne-guia-acciones"><button type="button" class="pne-guia-cancelar" onclick="pneCancelarGuiaAbastecimiento()">Volver</button><button type="button" class="pne-guia-continuar" id="pne-guia-btn-aceptar" onclick="pneAceptarGuiaAbastecimiento()" disabled>Aceptar e iniciar →</button></div>
    </div>
  </section>
</div>
<script>
let pneGuiaEsAdmin=false;
let pneGuiaEnCurso=false;
// Aceptación recordada por usuario y por versión de las instrucciones en este dispositivo.
const PNE_GUIA_VERSION='2026-10-15-v2-constancia';
// La constancia reside en Firestore y solo se accede mediante una función autenticada.
const pneFuncionAceptacionGuia=()=>ocrFunciones.httpsCallable('registrarAceptacionGuiaAbastecimiento');
async function pneConsultarAceptacionGuia(){
  const respuesta=await pneFuncionAceptacionGuia()({accion:'consultar',version:PNE_GUIA_VERSION});
  return respuesta.data?.aceptada===true;
}
function pneIniciarFormularioAbastecimiento(administrativo){
  pneModoAdminOCR=administrativo;
  abrirSeccion('abastecer');
  irPaso(1);
  if(administrativo){
    document.getElementById('pne-admin-ocr-identidad')?.classList.remove('oculto');
    const label=document.getElementById('app-step-label');
    if(label)label.textContent='Identificación del policía y selección del vehículo';
  }
}
async function pneSolicitarAceptacionAbastecimiento(esAdministrativo){
  if(!auth.currentUser){alert('Inicie sesión para realizar un abastecimiento.');return;}
  pneGuiaEsAdmin=esAdministrativo===true;
  if(pneGuiaEsAdmin&&!esAdmin){alert('Acceso reservado a administradores.');return;}
  const estado=document.getElementById('pne-guia-estado');
  if(estado)estado.textContent='Consultando constancia de aceptación…';
  try{
    const aceptada=await pneConsultarAceptacionGuia();
    if(!auth.currentUser)return;
    if(aceptada){pneIniciarFormularioAbastecimiento(pneGuiaEsAdmin);return;}
  }catch(e){
    // Ante error, mostrar la guía en lugar de confiar en una aceptación local.
    console.warn('No fue posible consultar la constancia.',e);
  }
  pneGuiaEnCurso=true;
  const cuadro=document.getElementById('pne-guia-capa');
  document.querySelectorAll('#pne-guia-capa input[type="checkbox"]').forEach(c=>{c.checked=false;});
  document.getElementById('pne-guia-btn-aceptar').disabled=true;
  if(estado)estado.textContent='Todas las confirmaciones son obligatorias. La aceptación quedará registrada.';
  pneActualizarAceptacionAbastecimiento();
  cuadro.classList.add('pne-guia-visible');cuadro.setAttribute('aria-hidden','false');
  document.body.classList.add('pne-guia-bloqueado');
  document.getElementById('pne-guia-tarjeta').focus();
}
function pneActualizarAceptacionAbastecimiento(){
  const checks=[...document.querySelectorAll('#pne-guia-capa input[type="checkbox"]')];
  const aceptadas=checks.filter(c=>c.checked).length;
  document.getElementById('pne-guia-btn-aceptar').disabled=aceptadas!==checks.length;
  const progreso=document.getElementById('pne-guia-progreso');
  if(progreso)progreso.textContent=`${aceptadas} de ${checks.length} confirmaciones aceptadas`;
}
function pneCerrarGuiaAbastecimiento(){
  const cuadro=document.getElementById('pne-guia-capa');
  cuadro.classList.remove('pne-guia-visible');cuadro.setAttribute('aria-hidden','true');
  document.body.classList.remove('pne-guia-bloqueado');pneGuiaEnCurso=false;
}
function pneCancelarGuiaAbastecimiento(){pneCerrarGuiaAbastecimiento();}
async function pneAceptarGuiaAbastecimiento(){
  if(!pneGuiaEnCurso || [...document.querySelectorAll('#pne-guia-capa input[type="checkbox"]')].some(c=>!c.checked))return;
  const administrativo=pneGuiaEsAdmin;
  if(!auth.currentUser||(administrativo&&!esAdmin)){pneCerrarGuiaAbastecimiento();return;}
  const uid=auth.currentUser.uid;
  const boton=document.getElementById('pne-guia-btn-aceptar');
  const estado=document.getElementById('pne-guia-estado');
  boton.disabled=true;boton.textContent='Registrando constancia…';
  if(estado)estado.textContent='Guardando su aceptación en el servidor…';
  try{
    const respuesta=await pneFuncionAceptacionGuia()({accion:'aceptar',version:PNE_GUIA_VERSION,confirmaciones:{procedimiento:true,recomendaciones:true,prohibiciones:true,veracidad:true}});
    if(respuesta.data?.ok!==true||auth.currentUser?.uid!==uid)throw new Error('No se pudo confirmar la constancia.');
    pneCerrarGuiaAbastecimiento();
    pneIniciarFormularioAbastecimiento(administrativo);
    if(typeof pneConfirmarProceso==='function')pneConfirmarProceso('Aceptación registrada correctamente. Puede continuar.');
  }catch(e){
    if(estado)estado.textContent='No fue posible guardar la constancia. Compruebe su conexión e inténtelo nuevamente. '+(e?.message||'');
  }finally{
    boton.textContent='Aceptar e iniciar →';
    if(pneGuiaEnCurso)pneActualizarAceptacionAbastecimiento();
  }
}
</script>

<script id="pne-centro-alertas-v1">
let pneAlertasVista=[];
const pneEtiquetasEstado={pendiente:'Pendiente',justificada:'Justificada',requiere_revision:'Requiere revisión',remitida:'Remitida',cerrada:'Cerrada'};
function pneNombreEstado(estado){return pneEtiquetasEstado[estado]||String(estado||'Sin estado');}
function pneNodo(tag,clase,texto){const e=document.createElement(tag);if(clase)e.className=clase;if(texto!==undefined)e.textContent=String(texto);return e;}
function pneBadgeAlertas(cantidad){
  const btn=document.getElementById('pn-boton-administracion');
  if(!btn)return;
  let badge=btn.querySelector('.pne-alertas-badge');
  if(!esAdmin||!auth.currentUser||cantidad<=0){badge?.remove();return;}
  if(!badge){badge=pneNodo('span','pne-alertas-badge');btn.append(badge);}
  badge.textContent=cantidad>99?'99+':String(cantidad);
  badge.setAttribute('aria-label',`${cantidad} alertas pendientes`);
  btn.setAttribute('title',`${cantidad} alertas requieren revisión administrativa`);
}
async function pneActualizarIndicadorAlertas(){
  if(!esAdmin||!auth.currentUser||document.hidden){if(!esAdmin)pneBadgeAlertas(0);return;}
  if(pneActualizarIndicadorAlertas.ocupado)return;
  pneActualizarIndicadorAlertas.ocupado=true;
  try{
    const resp=await ocrFunciones.httpsCallable('gestionarAlertasCombustibleAdmin')({accion:'listar'});
    if(!esAdmin||!auth.currentUser)return;
    const cantidad=(resp.data?.alertas||[]).filter(a=>a.estado==='pendiente'||a.estado==='requiere_revision').length;
