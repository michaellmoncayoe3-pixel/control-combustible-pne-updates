function pneValidarPeriodoConsumo(desde,hasta){
    if(!/^\d{4}-\d{2}-\d{2}$/.test(desde)||!/^\d{4}-\d{2}-\d{2}$/.test(hasta))throw new Error('Seleccione dos fechas válidas.');
    const a=new Date(desde+'T00:00:00Z'),b=new Date(hasta+'T00:00:00Z');
    if(!Number.isFinite(+a)||!Number.isFinite(+b)||a.toISOString().slice(0,10)!==desde||b.toISOString().slice(0,10)!==hasta||a>b)throw new Error('El período no es válido.');
    if((b-a)/86400000>30)throw new Error('El período máximo por consulta es de 31 días.');
    if(hasta>fechaDiariaEcuador())throw new Error('La fecha final no puede estar en el futuro.');
}
async function pneConsultarConsumos(){
    if(!esAdmin||!auth.currentUser)return;
    const desde=document.getElementById('pne-consumo-desde')?.value,hasta=document.getElementById('pne-consumo-hasta')?.value;
    const estado=document.getElementById('pne-consumo-estado'),contenedor=document.getElementById('pne-consumo-resultados');
    const btn=document.getElementById('pne-consumo-consultar'),excel=document.getElementById('pne-consumo-excel');
    pneResumenConsumoActual=null;excel.disabled=true;contenedor.replaceChildren();
    try{
        pneValidarPeriodoConsumo(desde,hasta);btn.disabled=true;estado.textContent='Consultando los registros del período…';
        const snap=await db.collection('registros').where('fechaDiaEcuador','>=',desde).where('fechaDiaEcuador','<=',hasta).limit(2001).get();
        if(adminTabActual!=='consumo')return;
        if(snap.size>2000)throw new Error('Hay más de 2.000 abastecimientos en el período. Seleccione fechas más cortas para evitar un informe incompleto.');
        // Obtener TODA la flota solo al consultar; paginación sin omitir vehículos.
        estado.textContent='Consultando el catálogo de vehículos…';
        const vehiculos=new Map();
        const tamanio=400;let ultimo=null;
        while(true){
            let consulta=db.collection('vehiculos').orderBy(firebase.firestore.FieldPath.documentId()).limit(tamanio);
            if(ultimo)consulta=consulta.startAfter(ultimo);
            const lote=await consulta.get();
            for(const doc of lote.docs){
                const v=doc.data();
                const placa=String(v.placa||'').toUpperCase().replace(/[^A-Z0-9]/g,'');
                if(!placa)continue;
                if(vehiculos.has(placa))throw new Error('Hay placas duplicadas en la flota: '+placa+'. Corrija el catálogo antes de generar el reporte.');
                vehiculos.set(placa,{placa,modelo:String(v.modelo||''),combustible:String(v.tipoCombustible||''),id:doc.id});
            }
            if(lote.size<tamanio)break;
            ultimo=lote.docs[lote.docs.length-1];
            if(vehiculos.size>10000)throw new Error('La flota supera 10.000 vehículos. Consulte soporte antes de exportar para evitar un informe incompleto.');
        }
        if(adminTabActual!=='consumo')return;
        const agrupados=new Map();let omitidos=0;
        for(const doc of snap.docs){
            const r=doc.data(),placa=String(r.placa||'').toUpperCase().replace(/[^A-Z0-9]/g,'');
            const gal=Number(r.galonesCargados),km=Number(r.kmRecorridos);
            if(!placa||!Number.isFinite(gal)||gal<=0){omitidos++;continue;}
            if(!agrupados.has(placa))agrupados.set(placa,{placa,modelo:String(r.modelo||''),combustible:String(r.tipoCombustible||''),cantidad:0,galones:0,km:0,validosKm:0,subtotal:0,subtotalesValidos:0,ultima:''});
            const a=agrupados.get(placa);a.cantidad++;a.galones+=gal;
            if(Number.isFinite(km)&&km>0){a.km+=km;a.validosKm++;}
            if(Number.isFinite(Number(r.valorTotal))&&r.valorTotal!=null){a.subtotal+=Number(r.valorTotal);a.subtotalesValidos++;}
            if(r.fechaDiaEcuador>a.ultima)a.ultima=r.fechaDiaEcuador;
            if(!a.modelo&&r.modelo)a.modelo=String(r.modelo);
            if(!a.combustible&&r.tipoCombustible)a.combustible=String(r.tipoCombustible);
        }
        const filas=[...agrupados.values()].map(a=>{
            const v=vehiculos.get(a.placa);
            if(v){a.modelo=v.modelo||a.modelo;a.combustible=v.combustible||a.combustible;}
            return a;
        }).sort((a,b)=>a.placa.localeCompare(b.placa));
        const sinAbastecer=[...vehiculos.values()].filter(v=>!agrupados.has(v.placa)).sort((a,b)=>a.placa.localeCompare(b.placa));
        pneResumenConsumoActual={desde,hasta,filas,sinAbastecer,omitidos,totalRegistros:snap.size,totalVehiculos:vehiculos.size};
        excel.disabled=false;
        const nf=(n,d=2)=>Number(n).toLocaleString('es-EC',{minimumFractionDigits:d,maximumFractionDigits:d});
        const tabla=document.createElement('table');tabla.className='pne-consumo-tabla';
