  cancelar.onclick=()=>terminar(false);aceptar.onclick=()=>terminar(true);
  a.append(cancelar,aceptar);box.append(h,p,a);d.append(box);document.body.append(d);document.addEventListener('keydown',tecla,true);cancelar.focus();
 });
};
})();
</script>
<script id="pne-saldo-desplegable-responsive">
/* Desplegable visual del saldo. Los datos y la consulta Firebase existentes NO cambian. */
(function(){
  'use strict';
  function preparar(){
    const saldo=document.getElementById('pne-saldo-inicio');
    if(!saldo || saldo.dataset.responsiveListo==='1') return;
