    if(!permitirFotoOCR(archivo)){
        descartarImagenOCR(tipo);
        document.getElementById(esOdo?'ocr-estado':'ocr-factura-estado').textContent=mensajeErrorOCR(null,tipo);
        return;
    }
    const solicitud=esOdo?ocrSolicitud:ocrFacturaSolicitud;
    const url=URL.createObjectURL(evidenciaCompleta||archivo);
