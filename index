// Consulta limitada, exacta por cédula o prefijo de nombre/apellido.
async function buscarUsuarioAdmin(q){
 const texto=q.trim();if(texto.length<2)return [];
 const c=db.collection('usuarios');
 const busquedas=[c.where('cedula','==',texto).limit(1)];
 if(texto.length>=3){
   for(const campo of ['nombres','apellidos']){
     const t=texto.toUpperCase();
     busquedas.push(c.orderBy(campo).startAt(t).endAt(t+'\uf8ff').limit(1));
   }
 }
 const consultas=await Promise.allSettled(busquedas.map(x=>x.get()));
 const res=new Map();let error=null;
 for(const resultado of consultas){
   if(resultado.status==='fulfilled')resultado.value.docs.forEach(d=>res.set(d.id,{id:d.id,...d.data()}));
   else error=resultado.reason;
 }
 if(!res.size&&error)throw error;
 return [...res.values()].slice(0,1);
}


