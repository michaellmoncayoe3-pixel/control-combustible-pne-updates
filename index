/* Actualización obligatoria: solo para la aplicación nativa Android.
 * En Safari y otros navegadores la web se actualiza desde Firebase Hosting.
 */
(function(){
    if (!window.Capacitor?.isNativePlatform?.()) return;
    const urlOficial = /^https:\/\/github\.com\/michaellmoncayoe3-pixel\/control-combustible-pne-updates\/releases\/download\/v\d+\.\d+\.\d+\/control-combustible-pne-\d+\.\d+\.\d+\.apk$/;
    let consultaActual = 0;
    let informacion = null;
    function interfaz(){
        let fondo=document.getElementById('pne-bloqueo-version');
        if(fondo) return fondo;
        fondo=document.createElement('section');
        fondo.id='pne-bloqueo-version';
        fondo.setAttribute('role','alertdialog');
        fondo.setAttribute('aria-modal','true');
        fondo.innerHTML='<div class="pne-bloqueo-tarjeta"><div style="font-size:12px;letter-spacing:1px;color:#f5d37f;font-weight:800">POLICÍA NACIONAL · ECUADOR</div><h2 id="pne-titulo-update">Comprobando versión…</h2><p id="pne-texto-update">Verificando que la aplicación esté autorizada para continuar.</p><p id="pne-estado-update" role="status" style="color:#f5d37f"></p><button id="pne-boton-update" type="button" hidden>Actualizar ahora</button><button class="pne-secundario" id="pne-reintentar-update" type="button" hidden>Reintentar verificación</button></div>';
        document.body.appendChild(fondo);
        document.getElementById('pne-reintentar-update').onclick=()=>revisarVersion();
        document.getElementById('pne-boton-update').onclick=()=>instalarVersion();
        return fondo;
    }
    function pintar(titulo,descripcion,estado,mostrarActualizar,mostrarReintentar){
        const fondo=interfaz();fondo.hidden=false;
        document.getElementById('pne-titulo-update').textContent=titulo;
        document.getElementById('pne-texto-update').textContent=descripcion;
        document.getElementById('pne-estado-update').textContent=estado||'';
        document.getElementById('pne-boton-update').hidden=!mostrarActualizar;
        document.getElementById('pne-reintentar-update').hidden=!mostrarReintentar;
    }
    async function revisarVersion(){
        const id=++consultaActual;
        pintar('Comprobando versión…','Consultando la política de actualización de Control Combustible PNE.','Se necesita conexión a Internet.',false,false);
        try{
            const controlador=new AbortController();
            const limite=setTimeout(()=>controlador.abort(),12000);
            let respuesta;
            try {respuesta=await fetch(URL_VERSIONES+'?t='+Date.now(),{cache:'no-store',signal:controlador.signal});}
            finally{clearTimeout(limite);}
            if(!respuesta.ok)throw new Error('servidor HTTP '+respuesta.status);
            const datos=await respuesta.json();
            if(id!==consultaActual)return;
            const minimo=datos.minVersion||datos.versionMinima;
            if(typeof minimo!=='string'||!/^\d+\.\d+\.\d+$/.test(minimo))throw new Error('falta minVersion en version.json');
            if(!/^\d+\.\d+\.\d+$/.test(datos.version))throw new Error('versión publicada no válida');
            if(compararVersiones(minimo,VERSION_APP)>0){
                if(!urlOficial.test(datos.url||''))throw new Error('enlace oficial de APK no válido');
                informacion=datos;
                pintar('Actualización obligatoria','Debes instalar la versión '+datos.version+' para seguir utilizando la aplicación. Versión instalada: '+VERSION_APP+'.',String(datos.notas||'').slice(0,240),true,true);
            }else{
                informacion=null;
                const fondo=interfaz();fondo.hidden=true;
                // Evitar que el aviso opcional antiguo tape el panel después de verificar.
                if(document.getElementById('aviso-actualizacion-pne'))document.getElementById('aviso-actualizacion-pne').remove();
            }
        }catch(err){
            if(id!==consultaActual)return;
            informacion=null;
            pintar('Verificación necesaria','No se ha podido verificar la versión de la aplicación. Comprueba tu conexión y pulsa Reintentar. Para proteger los registros, el acceso permanece bloqueado.',String(err.message||err),false,true);
        }
    }
    async function instalarVersion(){
        if(!informacion)return;
        const boton=document.getElementById('pne-boton-update');
        boton.disabled=true;
        try{
            // Reutiliza el actualizador nativo integrado (descarga y abre instalador Android).
            await comprobarActualizacion(true);
            const existente=document.querySelector('#enlace-actualizacion button');
            if(existente && !existente.disabled){
                existente.click();
                document.getElementById('pne-estado-update').textContent='Sigue los pasos del instalador de Android. Al terminar, vuelve a abrir la aplicación.';
            }else{
                // Alternativa cuando el plugin no está disponible en esta compilación.
                window.location.href=informacion.url;
            }
        }catch(error){
            document.getElementById('pne-estado-update').textContent='No se pudo iniciar la actualización: '+pneMensajeErrorUsuario(error);
        }finally{boton.disabled=false;}
    }
    document.addEventListener('DOMContentLoaded',()=>{interfaz();revisarVersion();});
    document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')revisarVersion();});
})();

