// Gestión de evidencias. La Cloud Function verifica el custom claim admin.
function textoImagenAdmin(el,txt){el.textContent=txt;return el;}
// Mostrar únicamente imágenes del bucket institucional que constan en el registro.
function abrirEvidenciaAdmin(url,tipo,placa){
    if(!esAdmin || !auth.currentUser)return;
    const origen=String(url||'');
    let valida=false;
    try{
        const u=new URL(origen);
        valida=u.protocol==='https:' && u.hostname==='firebasestorage.googleapis.com' &&
          decodeURIComponent(u.pathname).includes('/b/combustible-subzona-azuay.firebasestorage.app/o/');
    }catch(_){valida=false;}
    if(!valida){alert('La fotografía no tiene un enlace válido. Contacte al administrador.');return;}
    const overlay=document.createElement('div');
    overlay.className='pne-visor-evidencia';
    overlay.setAttribute('role','dialog');
    overlay.setAttribute('aria-modal','true');
    overlay.setAttribute('aria-label','Vista de evidencia del '+tipo);
    overlay.tabIndex=-1;
    const caja=document.createElement('section');caja.className='pne-visor-caja';
    const barra=document.createElement('header');barra.className='pne-visor-cabecera';
    const grupo=document.createElement('div');grupo.className='pne-visor-titulos';
    const etiqueta=document.createElement('span');etiqueta.className='pne-visor-etiqueta';
    etiqueta.textContent='EVIDENCIA DE ABASTECIMIENTO';
    const titulo=document.createElement('h3');titulo.className='pne-visor-titulo';
    titulo.textContent=(tipo==='odómetro'?'Odómetro':'Factura')+' · '+String(placa||'Sin placa');
    const cerrar=document.createElement('button');cerrar.type='button';cerrar.className='pne-visor-cerrar';cerrar.textContent='✕ Cerrar';
    grupo.append(etiqueta,titulo);barra.append(grupo,cerrar);
    const cuerpo=document.createElement('div');cuerpo.className='pne-visor-cuerpo';
    const marco=document.createElement('div');marco.className='pne-visor-marco';
    const imagen=document.createElement('img');imagen.className='pne-visor-imagen';
    imagen.alt='Evidencia de '+tipo+' del vehículo '+String(placa||'');
    imagen.referrerPolicy='no-referrer';
    const ayuda=document.createElement('p');ayuda.className='pne-visor-ayuda';
    ayuda.setAttribute('role','status');ayuda.textContent='Cargando fotografía…';
    marco.append(imagen);cuerpo.append(marco,ayuda);caja.append(barra,cuerpo);overlay.append(caja);
    const focoPrevio=document.activeElement;
    const scrollAnterior=document.body.style.overflow;
    const cerrarModal=()=>{
        document.removeEventListener('keydown',tecla);
        overlay.remove();
        document.body.style.overflow=scrollAnterior;
        if(focoPrevio && focoPrevio.isConnected && typeof focoPrevio.focus==='function')focoPrevio.focus();
    };
    const tecla=e=>{
        if(e.key==='Escape'){e.preventDefault();cerrarModal();}
        if(e.key==='Tab'){
            e.preventDefault();cerrar.focus();
        }
    };
    cerrar.onclick=cerrarModal;
    overlay.addEventListener('click',e=>{if(e.target===overlay)cerrarModal();});
    imagen.onload=()=>{ayuda.textContent='Fotografía almacenada correctamente';};
    imagen.onerror=()=>{ayuda.textContent='No se pudo cargar esta fotografía. Compruebe la conexión y el enlace de la evidencia.';imagen.style.display='none';};
    document.body.append(overlay);
    document.body.style.overflow='hidden';
    document.addEventListener('keydown',tecla);
    cerrar.focus();
    imagen.src=origen;
}

