// Verificación previa no autentica a la persona: la unicidad definitiva la protege Firebase Auth.
let cedulaRegistroVerificada='';
let tokenConsultaCedula=0;
let temporizadorConsultaCedula=null;
// Caché temporal de sesión: evita repetir consultas innecesarias.
const cacheCedulaRegistro=new Map();
const ESPERA_CACHE_CEDULA=10*60*1000;
function resultadoCedulaEnCache(cedula){
  const dato=cacheCedulaRegistro.get(cedula);
  if(!dato)return null;
  if(Date.now()-dato.fecha>ESPERA_CACHE_CEDULA){cacheCedulaRegistro.delete(cedula);return null;}
  return dato;
}
function bloquearCamposRegistro(bloqueado){
  const area=document.getElementById('registro-datos-protegidos');
  if(!area)return;
  area.inert=bloqueado;
  area.setAttribute('aria-disabled',String(bloqueado));
  area.querySelectorAll('input,select,button').forEach(el=>{el.disabled=bloqueado;});
}
function alCambiarCedulaRegistro(){
  tokenConsultaCedula++;
  cedulaRegistroVerificada='';
  bloquearCamposRegistro(true);
  document.getElementById('nombres').value='';
  document.getElementById('apellidos').value='';
  const cedula=document.getElementById('cedula-nueva').value.trim();
  clearTimeout(temporizadorConsultaCedula);
  const msg=document.getElementById('msg-cedula');
  msg.className='mensaje oculto';
  if(cedula.length===10 && validarCedula()){
    // Ejecutar una sola verificación tras una pausa corta al terminar de escribir.
    temporizadorConsultaCedula=setTimeout(()=>{
      if(cedulaRegistroVerificada===cedula)return;
      consultarCedulaRegistro();
    },700);
  }
}
async function consultarNombreCedulaRegistro(cedula,ticket){
  const msg=document.getElementById('msg-cedula');
  msg.textContent='⏳ Buscando nombres automáticamente…';
  try{
    const cache=resultadoCedulaEnCache(cedula);
    const identidad=cache?.identidad||await ocrFunciones.httpsCallable('consultarNombrePorCedulaExterna')({cedula});
    if(ticket!==tokenConsultaCedula||document.getElementById('cedula-nueva').value.trim()!==cedula )return;
    if(identidad.data?.encontrado===true)cacheCedulaRegistro.set(cedula,{...(cache||{}),identidad,fecha:Date.now()});
    const nombre=identidad.data?.nombreCompleto;
    if(identidad.data?.encontrado===true&&nombre){
      const palabras=String(nombre).trim().replace(/\s+/g,' ').split(' ');
      if(palabras.length>=3){
        document.getElementById('nombres').value=palabras.slice(0,-2).join(' ');
        document.getElementById('apellidos').value=palabras.slice(-2).join(' ');
        msg.textContent='✅ Nombres y apellidos completados automáticamente. Verifique y corrija si hace falta.';
      }else msg.textContent='✅ Consulta completada. Complete nombres y apellidos manualmente.';
    }else msg.textContent='✅ Cédula disponible. No se obtuvo el nombre; introdúzcalo manualmente.';
  }catch(e){
    if(ticket===tokenConsultaCedula)msg.textContent='✅ Cédula disponible. Consulta de nombres no disponible; continúe manualmente.';
  }
}
async function consultarCedulaRegistro(){
  cedulaRegistroVerificada='';
  bloquearCamposRegistro(true);
  document.getElementById('nombres').value='';
  document.getElementById('apellidos').value='';
  const msg=document.getElementById('msg-cedula');
  if(!validarCedula())return;
  const cedula=document.getElementById('cedula-nueva').value.trim();
  const ticket=++tokenConsultaCedula;
  msg.className='mensaje';
  msg.textContent='⏳ Comprobando la cédula de manera segura…';
  try{
    const cache=resultadoCedulaEnCache(cedula);
    const respuesta=cache?.disponibilidad||await ocrFunciones.httpsCallable('consultarCedulaDisponible')({cedula});
    if(ticket!==tokenConsultaCedula||document.getElementById('cedula-nueva').value.trim()!==cedula)return;
    cacheCedulaRegistro.set(cedula,{...(cache||{}),disponibilidad:respuesta,fecha:Date.now()});
    if(respuesta.data?.disponible===true){
      cedulaRegistroVerificada=cedula;
      bloquearCamposRegistro(false);
      msg.className='mensaje exito';
      msg.textContent='✅ Cédula disponible. Buscando nombres automáticamente…';
      await consultarNombreCedulaRegistro(cedula,ticket);
    }else{
      msg.className='mensaje error';
      msg.textContent='⚠️ Esta cédula ya tiene una cuenta. Inicie sesión o solicite recuperación de acceso.';
    }
  }catch(e){
    if(ticket!==tokenConsultaCedula)return;
    msg.className='mensaje error';
    msg.textContent='No fue posible verificar la cédula. Intente nuevamente en unos minutos. '+
      (e.code==='functions/resource-exhausted'?'Límite temporal de consultas alcanzado.':'');
  }finally{}
}
async function registrarUsuario() {
    if (!validarCedula()) return;
    const cedulaActual=document.getElementById('cedula-nueva').value.trim();
    if(!cedulaRegistroVerificada||cedulaRegistroVerificada!==cedulaActual){
        const msg=document.getElementById('msg-cedula');
        msg.className='mensaje error';
        msg.textContent='Espere a que termine la verificación automática de la cédula.';
        bloquearCamposRegistro(true);
        return;
    }
    
    const cel = document.getElementById('celular').value.trim();
    if (!validarTelefono()) return;
    
    const nom = document.getElementById('nombres').value.trim();
    const ape = document.getElementById('apellidos').value.trim();
    const ran = document.getElementById('rango').value;
    const cla1 = document.getElementById('clave-nueva').value;
    const cla2 = document.getElementById('clave-confirmar').value;
    const msg = document.getElementById('msg-registro');
    msg.classList.add('oculto');
    
    if (!nom || !ape || !ran || !cel) {
