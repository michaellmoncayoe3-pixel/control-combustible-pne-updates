            estado.textContent=`${docs.length} registro(s) encontrados para ${fecha.value}.`;
            const restantes=docs.filter(d=>{const r=d.data();return Boolean(r.fotoOdometro||r.fotoFactura)});
            if(!restantes.length){textoImagenAdmin(listado.appendChild(document.createElement('p')),'No hay fotografías pendientes de eliminación en esta fecha.');return;}
