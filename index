            'border-radius:12px;font-weight:700;margin-top:12px';

        
let actualizacionDescargada = false;

boton.onclick = async () => {

    if (boton.disabled) return;

    boton.disabled = true;

    let listener = null;

    try {

        const capacitor = window.Capacitor;

        if (!capacitor?.isNativePlatform?.()) {
            throw new Error(
                'La actualización interna solo funciona en Android.'
            );
        }

        const actualizador = capacitor.Plugins?.Actualizador;

        if (!actualizador) {
            throw new Error(
                'El actualizador nativo no está disponible.'
            );
        }

        // Descargar solamente si todavía no está descargada.
        if (!actualizacionDescargada) {

            boton.textContent = 'Preparando descarga…';

            listener = await actualizador.addListener(
                'progresoDescarga',
                (evento) => {
                    const porcentaje = Number(evento.porcentaje);

                    if (Number.isFinite(porcentaje)) {
                        boton.textContent =
                            'Descargando… ' +
                            Math.max(0, Math.min(100, porcentaje)) +
                            '%';
                    }
                }
            );

await actualizador.descargarActualizacion({
    url: data.url
});

            // El plugin nativo ya verificó la APK.
            actualizacionDescargada = true;
        }

        boton.textContent = 'Abriendo instalador…';

        await actualizador.instalarActualizacion();

        // Android abrió el instalador.
        // No significa todavía que el usuario haya instalado la APK.
        boton.textContent = 'Continuar instalación';

    } catch (error) {

        const mensaje = error?.message || String(error);

        if (
            actualizacionDescargada &&
            mensaje.includes('Autoriza la instalación')
        ) {
            boton.textContent = 'Continuar instalación';

            alert(
                'Android necesita autorización para instalar ' +
                'actualizaciones desde esta aplicación.\n\n' +
                'Activa "Permitir desde esta fuente", ' +
                'regresa a Control Combustible PNE y pulsa ' +
                '"Continuar instalación".'
            );

        } else {

            boton.textContent = actualizacionDescargada
                ? 'Reintentar instalación'
                : 'Reintentar descarga';

            alert('Actualización: ' + mensaje);
        }

    } finally {

        if (listener) {
            try {
                await listener.remove();
            } catch (e) {
                console.warn('No se pudo retirar el listener:', e);
            }
        }

        boton.disabled = false;
    }
};


        enlace.appendChild(boton);
        enlace.classList.remove('oculto');

        if(!manual && ultimaVersionNotificada !== data.version){
            ultimaVersionNotificada = data.version;
            mostrarAvisoActualizacion(data.version, data.notas, boton);
        }

    } catch(error){
        estado.textContent =
            'No se pudo consultar la versión: ' + error.message;
    }
}

