    if (!cel) return true;
    
    if (cel.length !== 10 || !cel.startsWith('09') || !/^\d+$/.test(cel)) {
        msg.innerHTML = '⚠️ El número debe empezar con 09 y tener 10 dígitos';
        msg.className = 'mensaje error';
        msg.classList.remove('oculto');
        return false;
    }
    
    msg.innerHTML = '✅ Número de teléfono válido';
    msg.className = 'mensaje exito';
    msg.classList.remove('oculto');
    return true;
}

