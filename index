        entrada.setAttribute('aria-label',texto+' de la franja');
        entrada.oninput=()=>alCambiar(clave,entrada.value);
        etiqueta.append(entrada);
        fila.append(etiqueta);
    }
    const eliminar=document.createElement('button');
    eliminar.type='button';
    eliminar.className='boton-limpio mini-action pne-eliminar-franja';
