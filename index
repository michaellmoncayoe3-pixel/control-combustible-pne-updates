function mensajeErrorOCR(error, tipo){
    const codigo=String(error?.code||'').toLowerCase();
    const detalle=String(error?.message||'');
    console.error('[ControlCombustible OCR] Error de verificación:', {codigo, mensaje:detalle, tipo}, error);
    if(tipo==='factura' && error?.motivoFactura) return '⚠️ '+error.motivoFactura;
    if(/unauthenticated/.test(codigo)) return '⚠️ La sesión ha caducado. Cierre sesión e ingrese nuevamente.';
    if(/permission-denied/.test(codigo)) return '⚠️ No tiene autorización para realizar esta verificación. Contacte al administrador.';
    if(/not-found|unimplemented/.test(codigo)) return '⚠️ El servicio de lectura automática no está disponible. Contacte al administrador.';
    if(/unavailable|deadline-exceeded/.test(codigo)) return '⚠️ No se pudo realizar la lectura. Compruebe la conexión e intente nuevamente.';
    if(/resource-exhausted/.test(codigo)) return '⚠️ El servicio de lectura alcanzó temporalmente su límite. Intente más tarde.';
    if(tipo==='odometro' && /failed-precondition/.test(codigo) && detalle) return '⚠️ '+detalle.replace(/^.*?:\s*/,'');
    if(/internal|unknown|failed-precondition/.test(codigo)) return tipo==='odometro' ? '⚠️ No se pudo verificar la foto del odómetro. Tome nuevamente una fotografía válida, clara y enfocada. Si el mensaje persiste, contacte al administrador: el servicio de verificación puede estar fallando.' : '⚠️ No se pudo verificar la foto de la factura. Tome nuevamente una fotografía válida y legible. Si el mensaje persiste, contacte al administrador: el servicio de lectura puede estar fallando.';
    if(/La fotografía sí fue reconocida/.test(detalle)) return detalle;
    if(/imagen demasiado grande|foto demasiado grande|fotografía demasiado grande/i.test(detalle)) return '⚠️ La fotografía es demasiado grande. Tome otra foto más cercana y nítida.';
    if(/invalid-argument/.test(codigo) && /vehículo|vehiculo/i.test(detalle)) return '⚠️ Seleccione primero un vehículo y vuelva a tomar la fotografía.';
    return '⚠️ Ingrese una imagen válida y vuelva a tomar la foto. '+(tipo==='odometro'?'Recorte únicamente los dígitos del odómetro TOTAL. No incluya cifras de velocidad ni TRIP.':'La imagen debe mostrar una factura legible con placa, fecha, cantidad y subtotal.');
}
