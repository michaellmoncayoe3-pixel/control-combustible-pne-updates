    const recargar=document.getElementById('pne-saldo-recargar');
    const fechas=saldo.querySelector('.pne-saldo-fechas');
    const cifras=saldo.querySelector('.pne-saldo-cifras');
    const mensaje=saldo.querySelector('.pne-saldo-mensaje');
    const restante=document.getElementById('pne-saldo-restante');
    if(!encabezado || !titulo || !restante || !cifras) return;
    saldo.dataset.responsiveListo='1';
    const contenido=document.createElement('div');contenido.className='pne-saldo-detalles';contenido.id='pne-saldo-detalles-responsive';contenido.hidden=true;
    [recargar,fechas,cifras,mensaje].forEach(el=>{if(el)contenido.appendChild(el)});
    const boton=document.createElement('button');boton.type='button';boton.className='pne-saldo-toggle';boton.setAttribute('aria-controls',contenido.id);boton.setAttribute('aria-expanded','false');
