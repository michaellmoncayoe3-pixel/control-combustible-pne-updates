}
async function reducirImagenOCR(archivo){
    const img=await createImageBitmap(archivo);
    const esc=Math.min(1,1400/Math.max(img.width,img.height));
    const canvas=document.createElement('canvas');
    canvas.width=Math.max(1,Math.round(img.width*esc));
    canvas.height=Math.max(1,Math.round(img.height*esc));
    canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);img.close?.();
    const imagen=canvas.toDataURL('image/jpeg',.70);
    if(imagen.length>1800000)throw new Error('Imagen demasiado grande. Acérquese y tome otra fotografía.');
    return imagen;
}
async function analizarFotoFactura(archivo,solicitud,evidenciaCompleta=null){
    const galonesDeclarados=Number(document.getElementById('galones-reales').value);
    if(!Number.isFinite(galonesDeclarados)||galonesDeclarados<=0)throw new Error('Ingrese los galones de la factura antes de cargarla.');
    const evidenciaFactura=evidenciaCompleta instanceof Blob ? (await prepararImagenesOCR(evidenciaCompleta)).original : null;
    const estado=document.getElementById('ocr-factura-estado');
    estado.textContent='⏳ Verificando fecha, placa y galones de la factura…';
    try{
      const imagenes=await prepararImagenesOCR(archivo);
      let imagen=imagenes.original,resp;
      try{
        resp=await ocrFunciones.httpsCallable('verificarFactura')({imagen,...(evidenciaFactura?{fotoCompleta:evidenciaFactura}:{}),vehiculoId:vehiculoSeleccionado?.id||null,galonesDeclarados});
      }catch(error){
        if(!puedeReintentarOCR(error)||imagenes.optimizada===imagenes.original)throw error;
        estado.textContent='⏳ Reintentando lectura de factura con mejora automática…';
        imagen=imagenes.optimizada;
        resp=await ocrFunciones.httpsCallable('verificarFactura')({imagen,...(evidenciaFactura?{fotoCompleta:evidenciaFactura}:{}),vehiculoId:vehiculoSeleccionado?.id||null,galonesDeclarados});
      }
      // Solo reintentar si falta lectura de campos, nunca si hay discrepancia de placa o fecha.
      const previo=resp.data||{};
      const campos=previo.datos||{};
      if(!previo.valida && previo.coincidePlaca!==false &&
         (!campos.placa||!campos.fechaFactura||!(Number(campos.cantidad)>0)) &&
         imagenes.optimizada!==imagen){
         estado.textContent='⏳ Mejorando automáticamente la lectura de los campos de la factura…';
         imagen=imagenes.optimizada;
         resp=await ocrFunciones.httpsCallable('verificarFactura')({imagen,...(evidenciaFactura?{fotoCompleta:evidenciaFactura}:{}),vehiculoId:vehiculoSeleccionado?.id||null,galonesDeclarados});
      }
      if(solicitud!==ocrFacturaSolicitud)return;
      const d=resp.data||{},f=d.datos||{};
      if(!d.valida){
        const fechaHoy=fechaDiariaEcuador();
        const fechaRecibida=f.fechaFactura;
        const mostrarFecha=iso=>typeof iso==='string' && /^\d{4}-\d{2}-\d{2}$/.test(iso) ? iso.split('-').reverse().join('/') : iso;
        let motivo;
        if(!f.placa){
          motivo='No se pudo identificar la placa en la factura. Tome una fotografía más clara.';
        }else if(!d.coincidePlaca){
          motivo=`La placa de la factura (${f.placa}) no coincide con el vehículo seleccionado (${vehiculoSeleccionado?.placa||'sin placa'}). Revise el vehículo o utilice su factura correspondiente.`;
        }else if(!fechaRecibida){
          motivo='No se pudo reconocer la fecha de la factura. Asegúrese de que FECHA sea visible y legible.';
        }else if(fechaRecibida!==fechaHoy){
          motivo=`Fecha incorrecta: la factura es del ${mostrarFecha(fechaRecibida)}, pero el abastecimiento debe ser del ${mostrarFecha(fechaHoy)} (hora de Ecuador). Utilice una factura del día correspondiente.`;
        }else if(!Number.isFinite(Number(f.cantidad)) || Number(f.cantidad)<=0){
          motivo='No se pudo reconocer una CANTIDAD de galones válida. Tome una fotografía legible de la línea CANTIDAD.';
        }else if(f.galonesCoinciden!==true){
          motivo='Los galones ingresados no coinciden con la cantidad indicada en la factura.';
        }else{
          motivo='Los datos de la factura no superaron la verificación. Tome una fotografía clara y vuelva a intentarlo.';
        }
        const fallo=new Error(motivo);
        fallo.motivoFactura=motivo;
        throw fallo;
      }
      if(!Number.isFinite(Number(f.cantidad))||Number(f.cantidad)<=0||f.galonesCoinciden!==true){throw new Error('Los galones escritos no coinciden con los galones de la factura.');}
      // Misma regla de límite que el servidor (cálculo actual).
      if(!Number.isFinite(galonesACargar)||galonesACargar<=0)throw new Error('Primero calcule los galones autorizados.');
      if(Number(f.cantidad)>galonesACargar+0.005)
        { const motivo=`Galones superiores al máximo: la factura indica ${Number(f.cantidad).toFixed(2)} gal, pero el máximo estimado por recorrido es ${galonesACargar.toFixed(2)} gal.`; const fallo=new Error(motivo); fallo.motivoFactura=motivo; throw fallo; }
      fotoFactura=evidenciaFactura||imagen;
      ocrFacturaValidacion={id:d.verificacionId,vehiculoId:vehiculoSeleccionado.id,placa:f.placa,galones:Number(f.cantidad),total:Number(f.total),fechaFactura:f.fechaFactura};
      document.getElementById('galones-reales').value=ocrFacturaValidacion.galones.toFixed(2);
      document.getElementById('valor-total').value=ocrFacturaValidacion.total.toFixed(2);
      document.getElementById('ocr-placa-factura').textContent=f.placa;
      document.getElementById('ocr-placa-vehiculo').textContent=vehiculoSeleccionado.placa;
      document.getElementById('ocr-fecha-factura').textContent=f.fechaFactura.split('-').reverse().join('/');
      document.getElementById('ocr-maximo-galones').textContent=galonesACargar.toFixed(2)+' gal';
      document.getElementById('ocr-galones-factura').textContent=ocrFacturaValidacion.galones.toFixed(2);
      document.getElementById('ocr-total-factura').textContent='$'+ocrFacturaValidacion.total.toFixed(2);
      document.getElementById('ocr-factura-datos').classList.remove('oculto');
      document.getElementById('ocr-factura-confirmada').disabled=false;
      estado.textContent='✅ Placa, fecha y galones verificados. Precio contractual aplicado. Confirme los datos.';
      actualizarResumenComprobante();
    }catch(e){
      if(solicitud!==ocrFacturaSolicitud)return;
      descartarImagenOCR('factura');
      estado.textContent=mensajeErrorOCR(e,'factura');
      if(e?.motivoFactura)pneReportarIntentoRechazado('factura_inconsistente');
    }
}
function validarFacturaConfirmada(){
    const v=ocrFacturaValidacion;
    return !!v && !!document.getElementById('ocr-factura-confirmada').checked &&
      v.vehiculoId===vehiculoSeleccionado?.id &&
      v.fechaFactura===fechaDiariaEcuador() &&
      v.galones<=galonesACargar+0.005 &&
      Number(document.getElementById('galones-reales').value)===v.galones &&
      Number(document.getElementById('valor-total').value)===v.total;
}

function cargarFoto(input,id,evidenciaCompleta=null){
    const archivo=input.files?.[0];if(!archivo)return;
