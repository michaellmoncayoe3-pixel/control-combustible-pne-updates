function pneVistaAdminIndependiente(tab){
    const detalle=!!tab;
    // Mostrar una sola vista: algunos estilos históricos fuerzan display:grid !important
    // y, si solo se agrega la clase oculto, dejan la altura del menú en blanco.
    const alternar=(el,visible)=>{
        if(!el)return;
        el.classList.toggle('oculto',!visible);
        el.hidden=!visible;
        if(!visible)el.style.setProperty('display','none','important');
        else el.style.removeProperty('display');
    };
    alternar(document.querySelector('#panel-admin .pn-admin-nav'),!detalle);
    alternar(document.getElementById('pne-admin-encabezado'),!detalle);
    alternar(document.getElementById('pne-admin-inicio'),!detalle);
    alternar(document.getElementById('admin-detalle'),detalle);
    const titulo=document.getElementById('pne-admin-titulo-pagina');
    if(titulo)titulo.textContent=pneAdminTitulos[tab]||'Administración';
    if(detalle){
        // El contenido debe empezar arriba, sin reservar espacio para el menú oculto.
        const panel=document.getElementById('panel-admin');
        if(panel)panel.scrollIntoView({block:'start',behavior:'instant'});
    }
}
