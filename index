<!DOCTYPE html>
<!-- Control de Combustible PNE — Desarrollo: Michaell Moncayo, 2026. Los derechos corresponden a sus titulares legales. -->
<html lang="es">
<head>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#0A3472">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Control Combustible">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Policía Nacional del Ecuador — Control de Combustible</title>
    <script src="https://cdn.jsdelivr.net/npm/firebase@10.7.0/firebase-app-compat.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/firebase@10.7.0/firebase-auth-compat.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/firebase@10.7.0/firebase-firestore-compat.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/firebase@10.7.0/firebase-functions-compat.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --azul-principal: #0A3472;
            --azul-profundo: #062050;
            --azul-claro: #2563eb;
            --dorado-elegante: #b8860b;
            --dorado-suave: #d4af37;
            --dorado-palido: #f5deb3;
            --blanco: #ffffff;
            --gris-perla: #f8fafc;
            --gris-claro: #e2e8f0;
            --gris-medio: #94a3b8;
            --texto-oscuro: #1e293b;
            --texto-suave: #64748b;
            --exito: #16a34a;
            --error: #dc2626;
            --sombra-lujo: 0 20px 60px rgba(10, 52, 114, 0.25), 0 8px 24px rgba(0, 0, 0, 0.1);
            --borde-brillante: rgba(255, 255, 255, 0.18);
        }
        html, body {
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            color: var(--texto-oscuro);
            background: linear-gradient(135deg, #062050 0%, #0A3472 45%, #1e40af 100%);
            background-attachment: fixed;
            position: relative;
            overflow-x: hidden;
        }
        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: 
                radial-gradient(circle at 20% 20%, rgba(212, 175, 55, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(37, 99, 235, 0.1) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }
        .contenedor { 
            max-width: 540px; 
            margin: 0 auto; 
            padding: 32px 20px 60px; 
            position: relative;
            z-index: 1;
        }
        .cabecera {
            text-align: center; 
            padding: 28px 24px 32px; 
            color: var(--blanco);
        }
        .escudo-principal {
            width: 148px; 
            height: 148px; 
            object-fit: contain; 
            margin: 0 auto 20px;
            display: block; 
            background: var(--blanco); 
            border-radius: 50%;
            padding: 8px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25), inset 0 2px 8px rgba(184, 134, 11, 0.15);
        }
        .marca-texto {
            margin: 16px 0 4px;
        }
        .texto-policia {
            font-family: 'Oswald', sans-serif;
            font-size: clamp(30px, 8vw, 44px); 
            font-weight: 700;
            letter-spacing: 3px;
            color: var(--blanco);
            line-height: 1.1;
            text-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }
        .texto-ecuador {
            font-family: 'Oswald', sans-serif;
            font-size: 26px; 
            font-weight: 500;
            letter-spacing: 6px;
            color: var(--dorado-suave);
            line-height: 1; 
            margin-top: 4px;
        }
        .subtitulo-sistema {
            font-size: 13px; 
            color: rgba(255, 255, 255, 0.7);
            text-transform: uppercase; 
            letter-spacing: 2px; 
            margin-top: 16px;
            font-weight: 400;
        }
        .tarjeta {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(24px);
            border-radius: 24px; 
            padding: 36px 30px; 
            margin-bottom: 28px;
            box-shadow: var(--sombra-lujo);
            border: 1px solid var(--borde-brillante);
            animation: entradaSuave 0.7s ease-out;
        }
        @keyframes entradaSuave {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .pestañas {
            display: flex; 
            background: var(--gris-perla); 
            border-radius: 16px; 
            padding: 6px; 
            margin-bottom: 32px;
            box-shadow: inset 0 2px 6px rgba(10, 52, 114, 0.06);
        }
        .pestaña {
            flex: 1; 
            padding: 16px 12px; 
            text-align: center; 
            border-radius: 12px;
            font-weight: 600; 
            font-size: 15px; 
            color: var(--texto-suave); 
            cursor: pointer;
            transition: all 0.35s ease;
            letter-spacing: 0.3px;
        }
        .pestaña.activa {
            background: linear-gradient(135deg, var(--azul-principal) 0%, var(--azul-claro) 100%);
            color: var(--blanco); 
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(10, 52, 114, 0.3);
        }
        .etiqueta {
            font-size: 13px; 
            font-weight: 600; 
            color: var(--texto-suave); 
            margin: 22px 0 10px; 
            display: block;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        input, select {
            width: 100%; 
            padding: 16px 20px; 
            margin-bottom: 6px; 
            border-radius: 14px;
            font-size: 15px; 
            border: 2px solid var(--gris-claro);
            transition: all 0.3s ease;
            background: var(--blanco); 
            color: var(--texto-oscuro);
            font-family: 'Inter', sans-serif;
        }
        input:focus, select:focus {
            outline: none; 
            border-color: var(--azul-claro);
            box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.12);
        }
        input:valid:not(:placeholder-shown) {
            border-color: rgba(22, 163, 74, 0.3);
        }
        button {
            width: 100%; 
            padding: 17px 24px; 
            border-radius: 14px;
            font-size: 16px; 
            font-weight: 700; 
            border: none; 
            cursor: pointer;
            transition: all 0.35s ease; 
            margin-top: 16px;
            letter-spacing: 0.5px;
            font-family: 'Inter', sans-serif;
        }
        button:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; }
        .boton-dorado {
            background: linear-gradient(135deg, var(--dorado-elegante) 0%, var(--dorado-suave) 100%);
            color: var(--blanco); 
            box-shadow: 0 6px 20px rgba(184, 134, 11, 0.35);
        }
        .boton-dorado:hover { 
            transform: translateY(-3px); 
            box-shadow: 0 10px 30px rgba(184, 134, 11, 0.45);
        }
        .boton-azul {
            background: linear-gradient(135deg, var(--azul-profundo) 0%, var(--azul-principal) 100%);
            color: var(--blanco); 
            box-shadow: 0 6px 20px rgba(10, 52, 114, 0.35);
        }
        .boton-azul:hover { 
            transform: translateY(-3px); 
            box-shadow: 0 10px 30px rgba(10, 52, 114, 0.45);
        }
        .boton-limpio {
            background: transparent; 
            color: var(--azul-principal); 
            border: 2px solid var(--azul-principal);
        }
        .boton-limpio:hover { 
            background: var(--azul-principal); 
            color: var(--blanco);
            transform: translateY(-2px);
        }
        .oculto { display: none !important; }
        .mensaje {
            padding: 14px 18px; 
            border-radius: 12px; 
            margin: 12px 0 4px; 
            font-weight: 500; 
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .exito { 
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); 
            color: #166534; 
            border-left: 4px solid var(--exito); 
        }
        .error { 
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); 
            color: #b91c1c; 
            border-left: 4px solid var(--error); 
        }
        .alerta { 
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); 
            color: #92400e; 
            border-left: 4px solid #f59e0b; 
        }
        .info-usuario {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
            border-radius: 20px; 
            padding: 28px; 
            margin-bottom: 24px;
            border: 1px solid rgba(37, 99, 235, 0.15);
        }
        .info-usuario p { 
            margin: 14px 0; 
            font-size: 15px; 
            line-height: 1.6;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .info-usuario strong { 
            color: var(--azul-profundo); 
            font-weight: 700; 
            min-width: 100px; 
            display: inline-block;
        }
        .fila-doble {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }
        .tarjeta-dato {
            background: var(--gris-perla);
            border-radius: 14px;
            padding: 20px 16px;
            text-align: center;
            border: 1px solid var(--gris-claro);
        }
        .tarjeta-dato .etiqueta { 
            margin: 0 0 8px; 
            font-size: 12px; 
            text-transform: uppercase; 
            letter-spacing: 0.5px;
            color: var(--texto-suave);
        }
        .tarjeta-dato .valor { 
            font-size: 22px; 
            font-weight: 700; 
            color: var(--azul-principal);
        }
        .numero-grande {
            font-size: 42px; 
            font-weight: 800; 
            color: var(--dorado-elegante); 
            text-align: center; 
            margin: 20px 0 8px;
            letter-spacing: -1px;
        }
        .subtitulo-dato {
            text-align: center; 
            color: var(--texto-suave); 
            font-size: 14px; 
            margin-bottom: 20px;
        }
        .resumen {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border-radius: 16px; 
            padding: 24px; 
            margin: 24px 0; 
            border-left: 4px solid var(--azul-claro);
        }
        .fila-datos {
            display: flex; 
            justify-content: space-between; 
            padding: 14px 0; 
            border-bottom: 1px solid var(--gris-claro);
            font-size: 15px;
        }
        .fila-datos:last-child { border-bottom: none; }
        .dato-valor { font-weight: 700; color: var(--azul-principal); }
        .buscador { position: relative; margin-bottom: 8px; }
        .buscador input { padding-left: 48px; background: var(--gris-perla); }
        .icono-buscar { 
            position: absolute; 
            left: 18px; 
            top: 50%; 
            transform: translateY(-50%); 
            font-size: 18px; 
            color: var(--texto-suave); 
        }
        .lista-vehiculos {
            max-height: 320px; 
            overflow-y: auto; 
            border-radius: 14px; 
            background: var(--gris-perla); 
            margin-top: 12px;
            border: 1px solid var(--gris-claro);
        }
        .item-vehiculo {
            padding: 18px 20px; 
            border-bottom: 1px solid var(--gris-claro); 
            cursor: pointer; 
            transition: all 0.25s ease;
        }
        .item-vehiculo:hover, .item-vehiculo.seleccionado {
            background: linear-gradient(90deg, rgba(10, 52, 114, 0.06) 0%, rgba(37, 99, 235, 0.04) 100%);
            border-left: 4px solid var(--azul-claro);
        }
        .item-placa { font-weight: 700; color: var(--azul-principal); font-size: 17px; margin-bottom: 4px; }
        .item-detalle { font-size: 14px; color: var(--texto-suave); }
        .sin-resultados { padding: 32px; text-align: center; color: var(--texto-suave); font-size: 15px; }
        .vehiculo-seleccionado-info {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            border-radius: 14px; 
            padding: 20px; 
            margin-top: 16px; 
            border-left: 4px solid var(--exito);
        }
        .vehiculo-seleccionado-info p { font-weight: 600; color: #166534; font-size: 15px; }
        .foto-preview { 
            max-width: 100%; 
            border-radius: 14px; 
            margin-top: 14px; 
            border: 3px solid var(--gris-claro); 
            display: none; 
        }
        .foto-preview.mostrar { display: block; }
        .etiqueta-foto {
            display: block; 
            background: var(--gris-perla); 
            border: 2px dashed var(--gris-medio);
            border-radius: 14px; 
            padding: 32px 24px; 
            text-align: center; 
            cursor: pointer; 
            margin: 10px 0 18px;
            transition: all 0.3s ease;
        }
        .etiqueta-foto:hover { 
            border-color: var(--dorado-elegante); 
            background: rgba(184, 134, 11, 0.04); 
        }
        .icono { font-size: 32px; margin-bottom: 8px; display: block; }
        
        @media (max-width: 480px) {
            .contenedor { padding: 20px 16px 40px; }
            .tarjeta { padding: 28px 20px; border-radius: 20px; }
            .escudo-principal { width: 120px; height: 120px; }
            .fila-doble { grid-template-columns: 1fr; }
        }

/* Diseño institucional cristal translúcido */
html,body{background:radial-gradient(ellipse at 12% 10%,#2358a0 0%,transparent 43%),radial-gradient(ellipse at 85% 78%,#0b6d8a 0%,transparent 40%),linear-gradient(145deg,#03142d,#0b3471 52%,#061b3c);background-attachment:fixed}
body::before{background:radial-gradient(circle at 80% 5%,rgba(212,175,55,.14),transparent 36%),radial-gradient(circle at 12% 82%,rgba(82,168,255,.15),transparent 45%)}
.tarjeta{background:rgba(250,253,255,.83);-webkit-backdrop-filter:blur(24px) saturate(145%);backdrop-filter:blur(24px) saturate(145%);border:1px solid rgba(255,255,255,.72);box-shadow:0 20px 55px rgba(0,12,35,.24),inset 0 1px 0 rgba(255,255,255,.85)}
.info-usuario{background:linear-gradient(125deg,rgba(224,239,255,.73),rgba(255,255,255,.48));border:1px solid rgba(255,255,255,.7)}
.tarjeta-dato,.lista-vehiculos,.resumen,.pestañas{background:rgba(240,247,255,.57);border-color:rgba(255,255,255,.75)}
input,select{background:rgba(255,255,255,.75);border-color:rgba(123,158,198,.28)}
.cabecera{position:relative}.cabecera:before{content:'';position:absolute;inset:10px 0;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.12);border-radius:28px;pointer-events:none;backdrop-filter:blur(4px)}
.cabecera>*{position:relative}.escudo-principal{box-shadow:0 10px 38px rgba(0,0,0,.35),0 0 0 7px rgba(255,255,255,.12)}
.admin-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.admin-header h2{color:#082858;font-size:21px}.admin-tag{background:rgba(184,134,11,.13);color:#7b5305;padding:7px 10px;border-radius:999px;font-size:11px;font-weight:800;white-space:nowrap}
.admin-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:16px 0}.admin-stat{background:rgba(255,255,255,.57);border:1px solid rgba(255,255,255,.85);padding:14px 8px;border-radius:15px;text-align:center}.admin-stat strong{display:block;color:#082858;font-size:25px}.admin-stat small{font-size:11px;color:#52627a}
.admin-nav{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:16px 0}.admin-nav button{font-size:12px;padding:11px 5px;margin:0;border-radius:10px}.admin-row{border-bottom:1px solid rgba(10,52,114,.12);padding:12px 3px;overflow-wrap:anywhere}.admin-row:last-child{border:0}.admin-row strong{color:#092d62}.admin-row small{display:block;color:#58677d;margin-top:4px}.admin-scroll{max-height:350px;overflow:auto}.admin-note{font-size:12px;line-height:1.5;color:#52627a;margin-top:12px}.version-line{font-size:12px;color:#506581;text-align:center;margin-top:12px}.admin-form{margin-top:12px}.admin-form label{font-size:12px;font-weight:700;color:#425779;display:block;margin-top:12px}.admin-form input{margin-top:6px}.mini-action{font-size:12px;padding:9px 12px;margin:8px 0 0;width:auto}
@media(max-width:420px){.admin-grid{gap:5px}.admin-stat{padding:12px 4px}.admin-stat strong{font-size:21px}.admin-nav button{font-size:11px}}


/* Tema azul medianoche reflectante — edición 2 */
:root{--azul-principal:#071b3c;--azul-profundo:#030d22;--azul-claro:#2468ad;--sombra-lujo:0 25px 65px rgba(0,4,19,.50),0 2px 12px rgba(0,9,30,.26)}
html,body{background:radial-gradient(ellipse at 17% 9%,rgba(29,86,154,.38),transparent 43%),radial-gradient(ellipse at 89% 78%,rgba(16,64,117,.31),transparent 45%),linear-gradient(145deg,#020814 0%,#06152c 42%,#0a2445 75%,#020916 100%);background-attachment:fixed}
body::before{background:linear-gradient(117deg,transparent 19%,rgba(184,218,255,.075) 33%,transparent 43%),radial-gradient(ellipse at 75% 8%,rgba(177,212,255,.12),transparent 34%),radial-gradient(circle at 14% 82%,rgba(212,175,55,.075),transparent 34%);pointer-events:none}
.tarjeta{position:relative;overflow:hidden;background:linear-gradient(135deg,rgba(240,249,255,.86),rgba(204,225,245,.69) 52%,rgba(242,249,255,.80));border:1px solid rgba(239,249,255,.65);-webkit-backdrop-filter:blur(28px) saturate(145%);backdrop-filter:blur(28px) saturate(145%);box-shadow:0 25px 65px rgba(0,4,19,.48),inset 0 1px 1px rgba(255,255,255,.95),inset 0 -1px 0 rgba(120,163,207,.25)}
.tarjeta::before{content:'';position:absolute;left:-35%;top:-110px;width:160%;height:165px;transform:rotate(-12deg);background:linear-gradient(180deg,rgba(255,255,255,.32),rgba(255,255,255,.02));pointer-events:none}
.tarjeta>*{position:relative}
.info-usuario{background:linear-gradient(125deg,rgba(214,235,255,.78),rgba(179,209,240,.63))}
.tarjeta-dato,.lista-vehiculos,.resumen,.pestañas{background:rgba(225,239,253,.52);border:1px solid rgba(255,255,255,.67)}
input,select{background:rgba(249,252,255,.70);border-color:rgba(104,147,195,.34)}
.cabecera:before{background:linear-gradient(125deg,rgba(255,255,255,.10),rgba(255,255,255,.015) 48%,rgba(255,255,255,.055));border:1px solid rgba(214,233,255,.20);box-shadow:inset 0 1px 0 rgba(255,255,255,.20),0 14px 36px rgba(0,4,18,.22)}
.escudo-principal{box-shadow:0 12px 36px rgba(0,0,0,.48),0 0 0 7px rgba(214,235,255,.12),inset 0 1px 2px rgba(255,255,255,.85)}
.boton-azul{background:linear-gradient(120deg,#031127,#0b315f 52%,#164d83);box-shadow:inset 0 1px 0 rgba(255,255,255,.26),0 8px 20px rgba(2,15,38,.35)}
.admin-stat{background:linear-gradient(140deg,rgba(255,255,255,.80),rgba(205,227,249,.51));box-shadow:inset 0 1px 0 rgba(255,255,255,.8)}
@media(prefers-reduced-motion:reduce){.tarjeta{animation:none}}


/* Identidad del contrato y responsables — acabado institucional */
.identidad-contrato{margin:23px auto 0;max-width:540px;padding:21px 17px 17px;border:1px solid rgba(226,238,255,.26);border-radius:20px;background:linear-gradient(135deg,rgba(210,232,255,.14),rgba(9,33,73,.26) 62%,rgba(212,175,55,.07));box-shadow:inset 0 1px 0 rgba(255,255,255,.16),0 14px 35px rgba(0,7,24,.2);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);text-align:center}
.contrato-etiqueta{color:rgba(241,247,255,.78);font-size:10px;font-weight:700;letter-spacing:2.1px;line-height:1.6}
.contrato-numero{color:#f5d78a;font-family:'Oswald',sans-serif;font-weight:600;font-size:clamp(15px,3.8vw,20px);letter-spacing:.55px;line-height:1.45;margin-top:8px;overflow-wrap:anywhere;text-shadow:0 2px 10px rgba(0,0,0,.28)}
.responsables-contrato{display:grid;grid-template-columns:1fr;gap:9px;margin-top:13px;text-align:left}
.contrato-desplegable{margin-top:7px}
.contrato-desplegable summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px;padding:8px 4px;border-radius:10px;transition:background .2s ease}
.contrato-desplegable summary::-webkit-details-marker{display:none}
.contrato-desplegable summary:hover,.contrato-desplegable summary:focus-visible{background:rgba(255,255,255,.08)}
.contrato-desplegable summary:focus-visible{outline:2px solid #f5d78a;outline-offset:2px}
.contrato-desplegable summary .contrato-numero{margin-top:0}
.contrato-flecha{color:#f5d78a;font-size:16px;transition:transform .2s ease;flex-shrink:0}
.contrato-desplegable[open] .contrato-flecha{transform:rotate(180deg)}
.contrato-ayuda{display:block;font-size:11px;color:rgba(235,244,255,.72);margin-top:3px}
.contrato-desplegable[open] .contrato-ayuda{display:none}
.responsable-item{display:flex;gap:12px;align-items:flex-start;border:1px solid rgba(225,240,255,.17);border-radius:13px;padding:13px 14px;background:linear-gradient(125deg,rgba(255,255,255,.095),rgba(255,255,255,.035))}
.responsable-icono{display:grid;place-items:center;flex-shrink:0;width:29px;height:29px;border-radius:9px;color:#f4d484;background:rgba(212,175,55,.13);font-size:17px}
.responsable-cargo{display:block;color:#c9d8ed;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:5px}
.responsable-item strong{display:block;color:#fff;font-size:13px;font-weight:600;line-height:1.5;overflow-wrap:anywhere}
@media(min-width:650px){.identidad-contrato{padding:24px}.responsable-item strong{font-size:14px}}


/* Optimizaciones de renderizado para Android WebView — v1.4.3 preparación */
@media (max-width: 600px) {
  html, body { background-attachment: scroll !important; }
  .tarjeta { -webkit-backdrop-filter: none !important; backdrop-filter: none !important;
