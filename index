window.pnePedirConfirmacion=function(titulo,mensaje,etiqueta){
 return new Promise(resolve=>{
  const d=document.createElement('div');d.className='pne-ui-dialog-backdrop';d.setAttribute('role','presentation');
  const box=document.createElement('div');box.className='pne-ui-dialog';box.setAttribute('role','alertdialog');box.setAttribute('aria-modal','true');box.setAttribute('aria-label',String(titulo));
