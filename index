let pneAsignacionSeq=0, pneAsignacionTimer=null;
function pneBuscarVehiculoAsignacion(){
    clearTimeout(pneAsignacionTimer);
    const seq=++pneAsignacionSeq;
    const placa=(document.getElementById('asig-placa').value||'').toUpperCase().replace(/[^A-Z0-9]/g,'');
    const salida=document.getElementById('asig-resultado');
    document.getElementById('asig-vehiculo-id').value='';
    document.getElementById('asig-datos').classList.add('oculto');
    document.getElementById('asig-guardar').disabled=true;
    if(placa.length<2){salida.textContent='Escriba al menos dos caracteres de la placa.';return;}
    salida.textContent='Buscando el vehículo…';
    pneAsignacionTimer=setTimeout(async()=>{
        try{
            const snap=await db.collection('vehiculos').orderBy('placa').startAt(placa).endAt(placa+'\uf8ff').limit(1).get();
            if(seq!==pneAsignacionSeq||adminTabActual!=='asignaciones')return;
            salida.replaceChildren();
            if(snap.empty){salida.textContent='Vehículo no encontrado.';return;}
            const doc=snap.docs[0],v=doc.data();
            const b=document.createElement('button');b.type='button';b.className='boton-limpio mini-action';
            b.textContent='Seleccionar '+String(v.placa||'')+' · '+String(v.modelo||v.tipoVehiculo||'');
            b.onclick=()=>pneSeleccionarAsignacion(doc.id,v);
            salida.append(b);
        }catch(e){if(seq===pneAsignacionSeq)salida.textContent='No fue posible buscar el vehículo: '+pneMensajeErrorUsuario(e);}
    },300);
}
async function pneSeleccionarAsignacion(id,v){
    if(!esAdmin||!auth.currentUser)return;
    document.getElementById('asig-vehiculo-id').value=id;
    document.getElementById('asig-seleccion').textContent='Vehículo seleccionado: '+String(v.placa||'')+' · Asignación para '+fechaDiariaEcuador();
    document.getElementById('asig-datos').classList.remove('oculto');
    const status=document.getElementById('asig-estado');status.textContent='Consultando asignación existente…';
    ['asig-nombre','asig-cedula','asig-rango','asig-sector'].forEach(x=>document.getElementById(x).value='');
    try{
        const result=await ocrFunciones.httpsCallable('gestionarAsignacionAbastecimientoAdmin')({accion:'consultar',vehiculoId:id});
        if(document.getElementById('asig-vehiculo-id').value!==id)return;
        const yaAbastecio= result.data?.yaAbastecioHoy===true;
        document.getElementById('asig-guardar').disabled=yaAbastecio;
        if(yaAbastecio){
          status.textContent='⛔ Este vehículo YA ABASTECIÓ hoy ('+(result.data?.fecha||fechaDiariaEcuador())+'). No puede asignar personal nuevamente.';
          return;
        }
        document.getElementById('asig-guardar').disabled=false;
        const a=result.data?.asignacion;
        if(a){document.getElementById('asig-sector').value=a.sector||'';
          document.getElementById('asig-rango').value=a.rango||'';
          document.getElementById('asig-nombre').value=a.nombre||'';
          document.getElementById('asig-cedula').value=a.cedula||'';
          status.textContent='Existe una asignación para hoy. Puede reemplazarla antes del abastecimiento.';}
        else status.textContent='No existe una asignación para hoy. Complete los datos.';
    }catch(e){status.textContent='No se pudo consultar la asignación: '+pneMensajeErrorUsuario(e);}
}
