          lista.splice(0,lista.length,...hallados);
          resultados.replaceChildren();
        }catch(e){if(seq===secuenciaUsuario)resultados.textContent='Error de consulta: '+pneMensajeErrorUsuario(e);return;}
        const coincidencias=lista.map(u=>{
            const nombre=normalizar([u.nombres,u.apellidos].join(' '));
            const cedula=normalizar(u.cedula);
            const palabras=nombre.split(/\s+/).filter(Boolean);
            const coincide=nombre.includes(q)||cedula.includes(q);
            let prioridad=4;
            if(nombre===q||cedula===q)prioridad=0;
            else if(nombre.startsWith(q)||cedula.startsWith(q))prioridad=1;
            else if(palabras.some(p=>p.startsWith(q)))prioridad=2;
            return {u,coincide,prioridad};
        }).filter(r=>r.coincide).sort((a,b)=>a.prioridad-b.prioridad);
        // Igual que la búsqueda de vehículos: presentar UN resultado a la vez.
        const encontrado=coincidencias.length?coincidencias[0].u:null;
        if(!encontrado){
