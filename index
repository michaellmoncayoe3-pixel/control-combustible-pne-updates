let guardandoRegistro = false;
async function guardarRegistro() {
    if (guardandoRegistro) return;
    const sectorAbastecimiento=document.getElementById('sector-abastecimiento').value.trim();
    if(!sectorAbastecimiento){alert('⚠️ Debe indicar el sector o unidad policial.');return;}
    if (!vehiculoSeleccionado) {
        alert('⚠️ Seleccione un vehículo primero');
        return;
    }
    if(!vehiculoSeleccionado.tipoCombustible){alert('⚠️ El administrador debe configurar el tipo de combustible del vehículo.');return;}
    if (!fotoOdometro || !fotoFactura) {
        alert('⚠️ Adjunte ambas fotografías para continuar');
        return;
    }

    const galonesReales = Number(document.getElementById('galones-reales').value);
    const valorTotal = Number(document.getElementById('valor-total').value);
    if (!document.getElementById('galones-reales').value || !Number.isFinite(galonesReales) || galonesReales <= 0 ||
        !document.getElementById('valor-total').value || !Number.isFinite(valorTotal) || valorTotal <= 0) {
        alert('⚠️ Verifique los galones (CANTIDAD) y el valor sin IVA (SUBTOTAL) del comprobante.');
        return;
    }
    if(!Number.isFinite(galonesACargar)||galonesReales>galonesACargar+0.005){
        pneReportarIntentoRechazado('galones_excedidos',{galones:galonesReales,maximoGalones:Number(galonesACargar)});
        alert(`⚠️ Los galones de la factura (${galonesReales.toFixed(2)}) superan el máximo calculado (${Number(galonesACargar).toFixed(2)}).`);return;
    }
    const kmConfirmado=Number(document.getElementById("nuevo-km").value);
    if(!ocrValidacion || ocrValidacion.kilometraje!==kmConfirmado || !document.getElementById("ocr-confirmado").checked){
        alert("⚠️ La lectura del odómetro debe estar verificada y confirmada antes de guardar."); return;
    }
    let identidadAdminOCR=null;
    if(pneModoAdminOCR){try{identidadAdminOCR=pneIdentidadAdminOCR();}catch(e){alert(pneMensajeErrorUsuario(e));return;}}
    guardandoRegistro = true;
    const boton = document.querySelector('button[onclick="guardarRegistro()"]');
    if (boton) boton.disabled = true;
    try {
        if(!validarFacturaConfirmada()) throw new Error('Verifique y confirme placa, fecha y galones de la factura.');
        if(!ocrValidacion?.identificador || !ocrFacturaValidacion?.id) throw new Error('Falta verificar las fotografías.');
        const guardado=await ocrFunciones.httpsCallable('registrarAbastecimientoOCR')({
            vehiculoId:vehiculoSeleccionado.id,
            sector:sectorAbastecimiento,
            ...(identidadAdminOCR?{policiaReceptor:identidadAdminOCR}:{}),
            odometroVerificacionId:ocrValidacion.identificador,
            facturaVerificacionId:ocrFacturaValidacion.id,
            confirmacionOdometro:true,
            confirmacionFactura:true,
            llenadoCompleto:false,
            fotoOdometro,
            fotoFactura
        });
        if(!guardado.data?.ok) throw new Error('El servidor no confirmó el registro.');

        const ok = document.getElementById('confirmacion');
        ok.classList.remove('oculto');
        setTimeout(() => {
            ok.classList.add('oculto');
            document.getElementById('nuevo-km').value = '';
            document.getElementById('galones-reales').value = '';
            document.getElementById('valor-total').value = '';
            actualizarResumenComprobante();
            document.getElementById('sector-abastecimiento').value = '';
            actualizarSectorAbastecimiento();
            fotoOdometro=null;fotoFactura=null;
    resetearOCR();
            resetearFacturaOCR();
            document.getElementById('preview-odometro').classList.remove('mostrar');
            document.getElementById('preview-factura').classList.remove('mostrar');
            document.getElementById('seccion-resultados').classList.add('oculto');
            document.getElementById('seccion-factura').classList.add('oculto');
            // La operación fue confirmada por Firebase: iniciar una próxima captura limpia.
            vehiculoSeleccionado = null;
            galonesACargar = null;
            const buscarVehiculo = document.getElementById('buscar-vehiculo');
            if (buscarVehiculo) { buscarVehiculo.value = ''; buscarVehiculo.disabled = true; }
            const listaVehiculos = document.getElementById('lista-vehiculos');
            if (listaVehiculos) { listaVehiculos.classList.add('oculto'); listaVehiculos.innerHTML = ''; }
            const seleccionVehiculo = document.getElementById('vehiculo-seleccionado');
            if (seleccionVehiculo) seleccionVehiculo.classList.add('oculto');
            pasoActual = 1;
            if(pneModoAdminOCR){pneModoAdminOCR=false;document.getElementById('pne-admin-ocr-identidad').classList.add('oculto');}
            abrirSeccion('inicio');
            cargarVehiculos();
            // Mensaje de éxito persistente, visible al llegar al panel principal.
            mostrarAvisoGuardadoInicio();
            pneConfirmarProceso('Abastecimiento registrado correctamente.');
        }, 1500);
    } catch (e) {
        if (e.message === 'REGISTRO_DIARIO_DUPLICADO') {
            pneReportarIntentoRechazado('abastecimiento_repetido');
            alert('⚠️ Este vehículo ya tiene un registro realizado hoy. Podrá registrarlo nuevamente mañana.');
        } else {
            alert('⚠️ Error al guardar: ' + pneMensajeErrorUsuario(e));
        }
    } finally {
        guardandoRegistro = false;
        if (boton) boton.disabled = false;
    }
}

