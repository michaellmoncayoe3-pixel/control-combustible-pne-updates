    actualizar();new MutationObserver(actualizar).observe(restante,{subtree:true,characterData:true,childList:true});
    boton.addEventListener('click',()=>{const abierto=boton.getAttribute('aria-expanded')==='true';boton.setAttribute('aria-expanded',String(!abierto));contenido.hidden=abierto;});
