function compararVersiones(a,b){
    const x=String(a).split('.').map(Number),y=String(b).split('.').map(Number);
    for(let i=0;i<3;i++){if((x[i]||0)!==(y[i]||0))return (x[i]||0)>(y[i]||0)?1:-1;}return 0;
}

