// Control visual de horarios. No constituye una barrera de seguridad de Firestore.
function minutosEcuador(){
    const partes=new Intl.DateTimeFormat('en-GB',{timeZone:ZONA_HORARIA,hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date());
    return Number(partes.find(p=>p.type==='hour').value)*60+Number(partes.find(p=>p.type==='minute').value);
}
function convertirMinutos(h){if(!/^([01]\d|2[0-3]):[0-5]\d$/.test(h||''))return null;const [a,b]=h.split(':').map(Number);return a*60+b;}
function franjaValida(f){return convertirMinutos(f?.inicio)!==null&&convertirMinutos(f?.fin)!==null&&f.inicio!==f.fin;}
function dentroDeFranja(f,actual){
    if(!franjaValida(f))return false;
    const a=convertirMinutos(f.inicio),b=convertirMinutos(f.fin);
    return a<b?(actual>=a&&actual<b):(actual>=a||actual<b);
}
// Ventana temporal individual: comienza al conceder el permiso en Firebase
// y dura exactamente 20 minutos. Al vencer, se aplica de nuevo el horario general.
// La hora de concesión se escribe con serverTimestamp() para evitar confiar
// en el reloj del administrador.
const DURACION_PERMISO_INDIVIDUAL_MS=20*60*1000;
function estadoPermisoIndividual(uid){
    const c=configuracionHorarios||HORARIO_PREDETERMINADO;
    const permisos=c.habilitadosIndividuales||{};
    if(permisos[uid]!==true)return {activo:false,vence:0};
    if(c.tiposPermisosIndividuales?.[uid]==='permanente')return {activo:true,vence:null,permanente:true};
    const inicio=c.inicioPermisosIndividuales?.[uid];
    const tiempo=inicio&&typeof inicio.toMillis==='function'?inicio.toMillis():null;
    if(!Number.isFinite(tiempo))return {activo:false,vence:0,pendiente:true};
    const vence=tiempo+DURACION_PERMISO_INDIVIDUAL_MS;
    return {activo:Date.now()>=tiempo&&Date.now()<vence,vence};
}
function franjasParaUsuario(){
    const c=configuracionHorarios||HORARIO_PREDETERMINADO;
    // Los permisos temporales no sustituyen ni alteran las franjas generales.
    // Los permisos individuales históricos sin fecha no se activan automáticamente.
    return c.general||[];
}
function revisarAccesoHorario(){
    if(!auth.currentUser||!usuarioActivo.uid)return;
    const c=configuracionHorarios||HORARIO_PREDETERMINADO;
    const individual=estadoPermisoIndividual(usuarioActivo.uid);
    const franjas=franjasParaUsuario();
    const general=c.activo!==true||franjas.some(f=>dentroDeFranja(f,minutosEcuador()));
    const permitido=esAdmin||individual.activo||general;
    if(permitido){
        if(document.getElementById('pantalla-principal').classList.contains('oculto'))mostrarPrincipal();
        document.getElementById('pantalla-horario').classList.add('oculto');
    }else{
        document.getElementById('pantalla-acceso').classList.add('oculto');
        document.getElementById('pantalla-principal').classList.add('oculto');
        document.getElementById('pantalla-horario').classList.remove('oculto');
        document.getElementById('mensaje-horario').textContent=
            'Fuera del horario general autorizado (Ecuador): '+(franjas.length?franjas.map(f=>f.inicio+' a '+f.fin).join(' y '):'sin franjas')+
            '. Para un acceso extraordinario, solicite un permiso individual temporal o permanente al administrador.';
    }
}
function detenerControlHorarios(){
    if(cancelarEscuchaHorarios){cancelarEscuchaHorarios();cancelarEscuchaHorarios=null;}
