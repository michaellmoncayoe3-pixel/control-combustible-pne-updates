window.pneAvisoInstitucional=function(mensaje,tipo){
 let e=document.getElementById('pne-ui-toast');if(!e){e=document.createElement('div');e.id='pne-ui-toast';e.className='pne-ui-toast';e.setAttribute('role','status');e.setAttribute('aria-live','polite');document.body.append(e)}
 e.replaceChildren();e.dataset.tipo=['error','aviso'].includes(tipo)?tipo:'exito';
 const i=document.createElement('div');i.innerHTML=ico(e.dataset.tipo);e.append(i.firstChild);
 const t=document.createElement('span');t.textContent=String(mensaje||'');e.append(t);
