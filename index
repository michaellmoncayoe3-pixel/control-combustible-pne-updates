function permitirFotoOCR(archivo){return !!archivo && /^image\/(?:jpeg|png|webp|heic|heif)$/i.test(archivo.type||'image/jpeg') && archivo.size>1000 && archivo.size<12000000;}

/* Mejora automática suave para OCR: prueba el original antes de la versión optimizada.
   La evidencia guardada coincide exactamente con los bytes verificados por Firebase. */
async function prepararImagenesOCR(archivo){
  let bitmap;
  try{bitmap=await createImageBitmap(archivo);}catch(e){throw new Error('No se pudo abrir la fotografía. Use JPG o PNG.');}
  const objetivo=1500;
  const escala=Math.min(1,objetivo/Math.max(bitmap.width,bitmap.height));
  const ancho=Math.max(1,Math.round(bitmap.width*escala)),alto=Math.max(1,Math.round(bitmap.height*escala));
  const canvas=document.createElement('canvas');canvas.width=ancho;canvas.height=alto;
  const ctx=canvas.getContext('2d');ctx.drawImage(bitmap,0,0,ancho,alto);bitmap.close?.();
  // Calidad alta para retener dígitos y texto pequeño; una sola codificación inicial.
  let original=canvas.toDataURL('image/jpeg',0.79);
  if(original.length>1650000)original=canvas.toDataURL('image/jpeg',0.68);
  if(original.length>1750000)throw new Error('Imagen demasiado grande. Acérquese y vuelva a fotografiar.');
  return {original, get optimizada(){
    if(this._optimizada)return this._optimizada;
    const mejorada=document.createElement('canvas');mejorada.width=ancho;mejorada.height=alto;
    const mc=mejorada.getContext('2d');mc.filter='brightness(1.08) contrast(1.12)';mc.drawImage(canvas,0,0);
    const valor=mejorada.toDataURL('image/jpeg',0.76);
    this._optimizada=valor.length<=1750000?valor:original;
    return this._optimizada;
  }};
}
function puedeReintentarOCR(error){
  const codigo=String(error?.code||'').toLowerCase();
  const detalle=String(error?.message||'').toLowerCase();
  if(/permission-denied|unauthenticated|failed-precondition|resource-exhausted|unavailable|deadline-exceeded/.test(codigo))return false;
  if(/placa.*no coincide|fecha incorrecta|ya abastecido|kilometraje.*menor|kilometraje.*coincide|capacidad|límite/.test(detalle))return false;
  return /invalid-argument|internal|unknown/.test(codigo) ||
         /ilegible|no se pudo|no reconoc|odómetro|odometro|imagen válida|imagen valida/.test(detalle);
}

async function analizarFotoOdometro(archivo, solicitud, evidenciaCompleta=null){
    const estado=document.getElementById('ocr-estado');
    if(!(evidenciaCompleta instanceof Blob)){
      estado.textContent='⚠️ Debe seleccionar y aplicar el recorte de los números antes de verificar. La fotografía completa se conservará.';
      return;
    }
    estado.textContent='⏳ Leyendo kilometraje. Espere unos segundos…';
    try{
        const imagenes=await prepararImagenesOCR(archivo);
        const fotoEvidencia=evidenciaCompleta?(await prepararImagenesOCR(evidenciaCompleta)).original:imagenes.original;
        let imagen=imagenes.original, respuesta;
        try{
          respuesta=await ocrFunciones.httpsCallable('verificarOdometro')({imagen,fotoCompleta:fotoEvidencia,recorteSeleccionado:true,vehiculoId:vehiculoSeleccionado?.id||null});
        }catch(error){
          if(!puedeReintentarOCR(error)||imagenes.optimizada===imagenes.original)throw error;
          estado.textContent='⏳ Reintentando lectura con mejora automática de imagen…';
          imagen=imagenes.optimizada;
          respuesta=await ocrFunciones.httpsCallable('verificarOdometro')({imagen,fotoCompleta:fotoEvidencia,recorteSeleccionado:true,vehiculoId:vehiculoSeleccionado?.id||null});
        }
        if(solicitud!==ocrSolicitud)return;
        const data=respuesta.data||{};
        const km=Number(data.kilometraje);
        if(!data.confiable||!Number.isFinite(km)||km<0) throw new Error('No se pudo leer una cifra única. Recorte solamente los dígitos del odómetro total.');
        if(!vehiculoSeleccionado) throw new Error('Seleccione primero un vehículo.');
        const kmPrevio=Number(vehiculoSeleccionado.ultimoKm||0);
        if(km===kmPrevio) throw new Error('✅ La fotografía sí fue reconocida: '+km.toLocaleString('es-EC')+' km. Sin embargo, coincide con el último kilometraje registrado. Para evitar duplicados, se necesita un kilometraje mayor. Si el registro anterior está equivocado, solicite al administrador corregirlo.');
        if(km<kmPrevio) throw new Error('✅ La fotografía sí fue reconocida: '+km.toLocaleString('es-EC')+' km, pero es menor al último kilometraje ('+kmPrevio.toLocaleString('es-EC')+' km). Verifique que sea el odómetro total, no TRIP.');
        document.getElementById('nuevo-km').value=String(km);
        fotoOdometro=fotoEvidencia;
        ocrValidacion={kilometraje:km,verificadoEn:Date.now(),identificador:data.verificacionId||null};
        const casilla=document.getElementById('ocr-confirmado');
        casilla.disabled=false;
        const original=Number(data.lecturaOriginal);
        const redondeo=Number.isFinite(original)&&original!==km?` (lectura original ${original.toLocaleString('es-EC')} km; redondeada al entero más cercano)`:'';
        estado.textContent='✅ Lectura detectada: '+km.toLocaleString('es-EC')+' km'+redondeo+'. Revise que corresponda al contador TOTAL, no al velocímetro ni al contador TRIP, y confirme.';
    }catch(error){
        if(solicitud!==ocrSolicitud)return;
        descartarImagenOCR('odometro');
        estado.textContent=mensajeErrorOCR(error,'odometro');
        if(!/unavailable|deadline-exceeded|resource-exhausted|network/i.test(String(error?.code||'')))pneReportarIntentoRechazado('odometro_ilegible');
    }
}


