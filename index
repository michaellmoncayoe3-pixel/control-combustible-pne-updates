        const snap=await db.collection('registros').where('fechaDiaEcuador','>=',corte.desde).where('fechaDiaEcuador','<=',corte.hasta).get();
        const registros=snap.docs.map(doc=>({id:doc.id,...doc.data()}));
        const configPrecio=(await ocrFunciones.httpsCallable('gestionarPreciosCorteAdmin')({accion:'obtener',corte:corte.desde.slice(0,7)})).data?.precios;
        if(!configPrecio)throw new Error('No existen precios para este corte. Configúrelos en Administración → Precios por corte.');
        if(!registros.length){estado.textContent='No existen abastecimientos en este período.';return;}
        const grupos={ECOPAIS:[],DIESEL:[]};
        const incidencias=[];
        const seen=new Set();
        for(const r of registros){
            const placa=pneTextoSeguro(r.placa).toUpperCase().replace(/[^A-Z0-9]/g,'');
            const dia=pneTextoSeguro(r.fechaDiaEcuador);
