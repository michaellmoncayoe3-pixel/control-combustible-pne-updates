/**
 * Guarda los reportes XLSX en escritorio y ofrece compartir/guardar en Android.
 * En Capacitor usa Plugins.Filesystem/Share si están integrados; en navegadores
 * compatibles utiliza Web Share (archivo) y finalmente enlace Blob.
 */
async function pneDescargarExcelMovil(bytes, nombre) {
    const mime='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
    const blob=new Blob([bytes],{type:mime});
    const cap=window.Capacitor;
    const esNativo=Boolean(cap?.isNativePlatform?.());
    const fs=cap?.Plugins?.Filesystem;
    const compartir=cap?.Plugins?.Share;

    if(esNativo){
        // Una WebView Android no descarga de manera fiable enlaces blob:.
        // Los plugins nativos deben estar incorporados en la compilación Android.
        if(!fs || !compartir){
            throw new Error('Para guardar reportes en la aplicación Android faltan los componentes Filesystem y Share. Actualice la APK siguiendo las instrucciones del proyecto. Mientras tanto puede descargar los Excel desde Chrome.');
        }
        const base64=await new Promise((resolve,reject)=>{
            const lector=new FileReader();
            lector.onload=()=>resolve(String(lector.result).split(',')[1]||'');
            lector.onerror=()=>reject(new Error('No se pudo preparar el archivo Excel.'));
            lector.readAsDataURL(blob);
        });
        const ruta='reportes/'+nombre;
        try{
            // En Android moderno el directorio CACHE de la app no requiere permiso
            // de almacenamiento externo. Share expone el archivo vía content URI.
            const guardado=await fs.writeFile({path:ruta,data:base64,directory:'CACHE',recursive:true});
            if(!guardado?.uri)throw new Error('No se obtuvo la ubicación del archivo generado.');
            await compartir.share({
                title:nombre,
                text:'Reporte de combustible - Policía Nacional del Ecuador',
                url:guardado.uri,
                dialogTitle:'Guardar o compartir reporte Excel'
            });
            // Compartir abre el selector. No podemos afirmar que el archivo
            // haya terminado en Descargas sin que el usuario elija un destino.
            return 'Reporte preparado. Seleccione Guardar en archivos, Drive u otra aplicación compatible para conservar el Excel.';
        }catch(error){
            if(/cancel|cancelad|dismiss/i.test(String(error?.message||''))){
                return 'Se cerró el menú para compartir. Vuelva a generar el reporte si desea guardarlo.';
            }
            throw new Error('No se pudo abrir el archivo Excel en Android: '+String(error?.message||error));
        }
    }
    // Para Chrome Android y navegadores compatibles se prioriza compartir
    // como fichero real (sin enlace blob, que algunas WebViews bloquean).
    if(navigator.share && navigator.canShare && typeof File!=='undefined'){
        const archivo=new File([blob],nombre,{type:mime});
        if(navigator.canShare({files:[archivo]})){
            try{
                await navigator.share({files:[archivo],title:nombre});
                return 'Reporte preparado. Seleccione dónde guardar o compartir el archivo Excel.';
            }catch(error){
                if(/abort|cancel/i.test(String(error?.name||'')+' '+String(error?.message||''))){
                    return 'Se canceló la opción de compartir el Excel.';
                }
                // Si el navegador no pudo compartir, intentamos descarga normal.
                console.warn('No se pudo compartir; se intenta descarga:',error);
            }
        }
    }
    const url=URL.createObjectURL(blob);
    const enlace=document.createElement('a');
    enlace.href=url;enlace.download=nombre;enlace.rel='noopener';
    document.body.appendChild(enlace);
    enlace.click();enlace.remove();
    setTimeout(()=>URL.revokeObjectURL(url),60000);
    return 'Se solicitó la descarga del Excel. Revise la carpeta Descargas del navegador.';
}


