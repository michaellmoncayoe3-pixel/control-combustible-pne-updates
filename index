<script id="pne-fcm-admin-android-v1">
/* Integración FCM exclusivamente en la aplicación nativa Android.
 * La autorización administrativa se comprueba en Cloud Functions.
 */
(function(){
  const native=()=>Boolean(window.Capacitor?.isNativePlatform?.() && window.Capacitor?.getPlatform?.()==='android');
  const plugin=()=>window.Capacitor?.Plugins?.PushNotifications;
  const server=()=>firebase.app().functions('us-central1').httpsCallable('gestionarDispositivosPushPNE');
  let initialized=false, activeToken=null, pendingRegister=null, registeredUid=null, lastToken=null;
  function authenticatedAdmin(){return Boolean(firebase.auth().currentUser && window.esAdmin===true);}
  // `esAdmin` está declarado como variable léxica en el script principal; no es window.esAdmin.
  function admin(){return Boolean(firebase.auth().currentUser && typeof esAdmin!=='undefined' && esAdmin===true);}
  function openAlerts(){
    if(!admin())return;
    if(typeof abrirSeccion==='function')abrirSeccion('admin');
    if(typeof mostrarAdminTab==='function')mostrarAdminTab('alertas');
  }
  async function saveToken(token){
    const uid=firebase.auth().currentUser?.uid;
    if(!admin() || !uid || !token || token.length<30)return;
    if(registeredUid===uid && activeToken===token)return;
    if(pendingRegister)return pendingRegister;
    pendingRegister=(async()=>{
      await server()({accion:'registrar',token});
      if(firebase.auth().currentUser?.uid===uid){activeToken=token;registeredUid=uid;}
    })();
    try{await pendingRegister;}finally{pendingRegister=null;}
  }
  async function init(){
    if(!native())throw new Error('Esta función solo está disponible en la APK Android.');
    const push=plugin();
    if(!push)throw new Error('No se detecta el complemento PushNotifications. Sincronice Capacitor y reinstale la APK.');
    if(initialized)return push;
    await push.createChannel({id:'alertas_pne',name:'Alertas de combustible',description:'Avisos institucionales pendientes de revisión',importance:5,visibility:1,sound:'default'});
    await push.addListener('registration',async event=>{
      lastToken=event.value;
      try{await saveToken(lastToken);}catch(e){console.warn('FCM: fallo al asociar dispositivo:',e);}
    });
    await push.addListener('registrationError',e=>console.error('FCM: fallo de registro:',e));
    await push.addListener('pushNotificationActionPerformed',event=>{
      if(event.notification?.data?.seccion==='alertas'){
        if(admin())openAlerts();
        else window.pneAbrirAlertasTrasAcceso=true;
      }
    });
    initialized=true;
    return push;
  }
  window.pnePushActivar=async()=>{
    if(!admin())throw new Error('Inicie sesión como administrador autorizado.');
    const push=await init();
    let perm=await push.checkPermissions();
    if(perm.receive!=='granted')perm=await push.requestPermissions();
    if(perm.receive!=='granted')throw new Error('Permiso de notificaciones denegado en Android.');
    await push.register();
    if(lastToken)await saveToken(lastToken);
  };
  window.pnePushReconectar=async()=>{
    if(!native()||!admin())return;
    if(window.pneAbrirAlertasTrasAcceso){window.pneAbrirAlertasTrasAcceso=false;setTimeout(openAlerts,500);}
    try{
      const push=await init();
      const perm=await push.checkPermissions();
      // No mostrar el diálogo de permiso sin pulsar el botón de activación.
      if(perm.receive==='granted'){
        if(lastToken)await saveToken(lastToken);
        await push.register();
      }
    }catch(e){console.warn('FCM: reconexión pendiente:',e);}
  };
  window.pnePushDesactivar=async()=>{
    const token=activeToken||lastToken;
    const uid=firebase.auth().currentUser?.uid;
    if(!native()||!uid||!token){activeToken=null;registeredUid=null;return;}
    await server()({accion:'desactivar',token});
    activeToken=null;registeredUid=null;
    // Evita registrar de nuevo el mismo token hasta otra activación explícita.
    lastToken=null;
  };
})();
</script>

<script id="pne-saldo-corte-inicio-logica">
(function(){
 const money=n=>Number(n).toLocaleString('es-EC',{style:'currency',currency:'USD'});
 const formatDate=s=>{const [y,m,d]=String(s||'').split('-');return `${d}/${m}/${y}`;};
 function monthOfCurrentCut(){
  const bits=new Intl.DateTimeFormat('en-US',{timeZone:'America/Guayaquil',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());
  const get=t=>Number(bits.find(x=>x.type===t).value);
  const y=get('year'),m=get('month'),d=get('day');
  const dt=new Date(Date.UTC(y,m-1+(d<12?-1:0),1));
  return `${dt.getUTCFullYear()}-${String(dt.getUTCMonth()+1).padStart(2,'0')}`;
 }
 let loading=false;
 async function update(){
  const section=document.getElementById('pne-saldo-inicio');
  if(!section)return;
  if(!firebase.auth().currentUser){section.hidden=true;section.classList.add('oculto');return;}
  section.hidden=false;section.classList.remove('oculto');
  if(loading)return;loading=true;
  const message=document.getElementById('pne-saldo-mensaje');
  const month=monthOfCurrentCut();
  const [year,mm]=month.split('-').map(Number);
  const next=new Date(Date.UTC(year,mm,1));
  document.getElementById('pne-saldo-fechas').textContent=`Período: 12/${String(mm).padStart(2,'0')}/${year} al 11/${String(next.getUTCMonth()+1).padStart(2,'0')}/${next.getUTCFullYear()}`;
  message.textContent='Actualizando los datos del corte…';
  try{
   const result=(await firebase.app().functions('us-central1').httpsCallable('consultarSaldoCortePNE')({mesCorte:month})).data;
   if(!result||!result.corte)throw new Error('Respuesta del servicio incompleta.');
   document.getElementById('pne-saldo-fechas').textContent=`Período: ${formatDate(result.corte.desde)} al ${formatDate(result.corte.hasta)}`;
   document.getElementById('pne-saldo-presupuesto').textContent=result.presupuesto==null?'No configurado':money(result.presupuesto);
   document.getElementById('pne-saldo-ejecutado').textContent=money(result.ejecutado);
   document.getElementById('pne-saldo-restante').textContent=result.saldo==null?'No disponible':money(result.saldo);
   section.classList.toggle('pne-saldo-negativo',result.saldo!=null&&result.saldo<0);
   message.textContent=result.presupuesto==null?'El administrador debe configurar el presupuesto de este corte.':result.registrosSinImporte?'Hay registros sin importe válido que requieren revisión.':result.saldo<0?'Atención: el presupuesto asignado ha sido superado.':'Actualizado con los abastecimientos del corte según la fecha de factura.';
  }catch(e){
   document.getElementById('pne-saldo-presupuesto').textContent='—';
   document.getElementById('pne-saldo-ejecutado').textContent='—';
   document.getElementById('pne-saldo-restante').textContent='—';
   message.textContent='No se pudo consultar el saldo del corte. Use Actualizar para reintentar.';
   console.warn('Consulta de saldo del corte no disponible:',e);
  }finally{loading=false;}
 }
 document.addEventListener('DOMContentLoaded',()=>{
  document.getElementById('pne-saldo-recargar')?.addEventListener('click',update);
  const main=document.getElementById('pne-inicio');
  if(main){new MutationObserver(()=>{if(!main.classList.contains('oculto')&&!document.getElementById('pantalla-principal')?.classList.contains('oculto'))update();}).observe(main,{attributes:true,attributeFilter:['class']});}
  firebase.auth().onAuthStateChanged(u=>{
   if(!u){const n=document.getElementById('pne-saldo-inicio');if(n){n.hidden=true;n.classList.add('oculto');}['pne-saldo-presupuesto','pne-saldo-ejecutado','pne-saldo-restante'].forEach(id=>{const x=document.getElementById(id);if(x)x.textContent='—';});}
   else update();
  });
  // Si el estado de autenticación, los claims y la pantalla cambian en distinto
  // orden, una segunda comprobación acotada evita depender de salir/entrar al menú.
  let startupChecks=0;
  const startupTimer=setInterval(()=>{
   if(++startupChecks>=12)clearInterval(startupTimer);
   const main=document.getElementById('pantalla-principal');
   if(main && !main.classList.contains('oculto') && firebase.auth().currentUser){
    clearInterval(startupTimer);update();
   }
  },350);
 });
