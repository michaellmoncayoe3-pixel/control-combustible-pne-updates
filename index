function calcularConsumo() {
    if(!document.getElementById('sector-abastecimiento').value.trim()){alert('⚠️ Escriba el sector o unidad policial.');return;}
    if (!vehiculoSeleccionado) {
        alert('⚠️ Seleccione una unidad primero');
        return;
    }
    
    const ult = Number(vehiculoSeleccionado.ultimoKm || 0);
    const nue = Number(document.getElementById('nuevo-km').value);
    const ren = Number(vehiculoSeleccionado.rendimientoKmPorGalon || 0);
    
    if (!nue || nue <= ult) {
        if(Number.isSafeInteger(nue)&&nue>0)pneReportarIntentoRechazado('km_inferior',{kilometraje:nue});
        alert(`⚠️ El kilometraje debe ser mayor a ${ult}`);
        return;
    }
    
    if (!Number.isFinite(ren) || ren <= 0) {
        alert('⚠️ Falta configurar un rendimiento válido del vehículo');
        return;
    }
    
    kmRecorridos = nue - ult;
    galonesConsumidos = kmRecorridos / ren;
    galonesACargar = 0;
    actualizarModalidadLlenado();
    
    document.getElementById('km-recorridos').textContent = kmRecorridos.toFixed(2) + ' km';
    document.getElementById('galones-consumidos').textContent = galonesConsumidos.toFixed(2) + ' gal';
    document.getElementById('galones-a-cargar').textContent = galonesACargar.toFixed(2) + ' gal';
    
    document.getElementById('seccion-resultados').classList.remove('oculto');
    document.getElementById('seccion-factura').classList.remove('oculto');
    
    document.getElementById('res-sector').textContent = document.getElementById('sector-abastecimiento').value.trim();
    document.getElementById('res-tipo-combustible').textContent = vehiculoSeleccionado.tipoCombustible || 'Sin configurar';
    document.getElementById('res-nombre').textContent = pneModoAdminOCR ? document.getElementById('pne-admin-ocr-nombre').value.trim() : `${usuarioActivo.nombres} ${usuarioActivo.apellidos}`;
    document.getElementById('res-vehiculo').textContent = `${vehiculoSeleccionado.placa} — ${vehiculoSeleccionado.modelo}`;
    document.getElementById('res-km').textContent = kmRecorridos.toFixed(2) + ' km';
    document.getElementById('res-galones').textContent = galonesACargar.toFixed(2) + ' gal';
}

// Fecha civil en Ecuador (UTC-5), independiente de la zona configurada en el teléfono.
function fechaDiariaEcuador(fecha = new Date()) {
    const partes = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Guayaquil', year: 'numeric', month: '2-digit', day: '2-digit'
    }).formatToParts(fecha);
    const dato = tipo => partes.find(p => p.type === tipo).value;
    return `${dato('year')}-${dato('month')}-${dato('day')}`;
}

function actualizarResumenComprobante() {
    const g = document.getElementById('galones-reales').value;
    const v = document.getElementById('valor-total').value;
    document.getElementById('res-galones-reales').textContent = g !== '' && Number(g)>0 ? Number(g).toFixed(2)+' gal' : 'Pendiente';
    document.getElementById('res-valor-total').textContent = v !== '' && Number(v)>0 ? '$ '+Number(v).toFixed(2) : 'Pendiente';
}

